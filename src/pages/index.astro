<script>
  const rumours = JSON.parse(document.getElementById('rumoursSeed').textContent);
  const TIMES = ['now', '2m', '5m', '11m', '23m', '38m', '1h', '2h', '4h', '6h', 'yesterday'];

  function initials(name) {
    return name.split(' ').map((w) => w[0]).slice(0, 2).join('').toUpperCase();
  }

  function shuffled(arr) {
    const copy = [...arr];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  function renderRumours() {
    const feed = document.getElementById('rumoursFeed');
    if (!feed) return;
    if (!rumours.length) {
      feed.innerHTML = '<p class="empty-note">Nothing doing right now — check back after the next sync.</p>';
      return;
    }
    const picks = shuffled(rumours).slice(0, 9);
    feed.innerHTML = picks.map((r) => `
      <div class="tweet-card">
        <div class="tweet-avatar" style="background:${r.color}">${initials(r.name)}</div>
        <div class="tweet-body">
          <div class="tweet-meta">
            <span class="tweet-name">${r.name}</span>
            <span class="tweet-check">&#10003;</span>
            <span class="tweet-handle">${r.handle}</span>
            <span class="tweet-time">${TIMES[Math.floor(Math.random() * TIMES.length)]}</span>
          </div>
          <div class="tweet-text">${r.text}</div>
        </div>
      </div>
    `).join('');
  }

  renderRumours();
  document.getElementById('rumoursRefresh')?.addEventListener('click', renderRumours);

  // ---- Live reactions: as soon as the admin logs a real move, the crowd starts talking ----
  const LIVE_FAN_PERSONAS = [
    { handle: '@BenchWarmerBrian', name: 'Brian', color: '#8AA095' },
    { handle: '@ArmchairGaffer', name: 'The Armchair Gaffer', color: '#FFB627' },
    { handle: '@TripleCaptainTom', name: 'Tom', color: '#37C871' },
    { handle: '@FPL_Degenerate', name: 'FPL Degenerate', color: '#E8543F' },
    { handle: '@BigManBants', name: 'Big Man Bants', color: '#8AA095' },
    { handle: '@ShoutyFromTheSofa', name: 'Shouty From The Sofa', color: '#E8543F' },
  ];

  function liveMoveText(d) {
    if (d.type === 'trade') {
      const aNames = (d.playersAToB || []).map((p) => p.name).join(' and ') || 'nothing';
      const bNames = (d.playersBToA || []).map((p) => p.name).join(' and ') || 'nothing';
      const lines = [
        `wait ${d.teamAName} actually traded ${aNames} to ${d.teamBName} for ${bNames}?? need a minute to process this 👀`,
        `${d.teamAName} and ${d.teamBName} just made a trade and the group chat has not recovered`,
        `trade alert: ${aNames} to ${d.teamBName}, ${bNames} to ${d.teamAName}. somebody's going to win this and somebody's going to lose this`,
      ];
      return lines[Math.floor(Math.random() * lines.length)];
    }
    if (d.type === 'remove') {
      return `${d.teamName} just cut ${d.playerName} loose. brutal, but somebody had to do it`;
    }
    const lines = [
      `${d.teamName} just added ${d.playerName} for ${d.price}m and I need everyone to just sit with that for a second 👀`,
      `${d.teamName} picking up ${d.playerName} live right now. genius or cry for help, genuinely could be both`,
      `breaking: ${d.playerName} to ${d.teamName} for ${d.price}m. bold. unhinged. slightly evil. I respect it 🔥`,
    ];
    return lines[Math.floor(Math.random() * lines.length)];
  }

  function reactToMove(d) {
    const feed = document.getElementById('rumoursFeed');
    if (!feed) return;
    const emptyNote = feed.querySelector('.empty-note');
    if (emptyNote) emptyNote.remove();
    const persona = LIVE_FAN_PERSONAS[Math.floor(Math.random() * LIVE_FAN_PERSONAS.length)];
    const card = document.createElement('div');
    card.className = 'tweet-card';
    card.innerHTML = `
      <div class="tweet-avatar" style="background:${persona.color}">${initials(persona.name)}</div>
      <div class="tweet-body">
        <div class="tweet-meta">
          <span class="tweet-name">${persona.name}</span>
          <span class="tweet-check">&#10003;</span>
          <span class="tweet-handle">${persona.handle}</span>
          <span class="tweet-time">now</span>
        </div>
        <div class="tweet-text">${liveMoveText(d)}</div>
      </div>
    `;
    feed.prepend(card);
    while (feed.children.length > 12) feed.removeChild(feed.lastChild);
  }
  (window as any).reactToMove = reactToMove;
</script>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-app.js";
  import { getFirestore, doc, onSnapshot, collection, query, orderBy, limit } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore.js";

  // Public client config — safe to expose; write access is restricted by
  // Firestore security rules (auth required), not by hiding this object.
  const firebaseConfig = {
    apiKey: "AIzaSyApmHdW9Jj__ejTY6jKu2j-TG_KyTQYVN4",
    authDomain: "fpl-auction.firebaseapp.com",
    projectId: "fpl-auction",
    storageBucket: "fpl-auction.firebasestorage.app",
    messagingSenderId: "113884648410",
    appId: "1:113884648410:web:ede97721bcf2c57aa3e6e3",
  };
  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  const seedTeams = JSON.parse(document.getElementById('teamsSeed').textContent);
  const playerPoints = new Map(
    JSON.parse(document.getElementById('playerPointsSeed').textContent).map((p) => [String(p.id), p.eventPoints]),
  );
  const playersNews = new Map(
    JSON.parse(document.getElementById('playersNewsSeed').textContent).map((p) => [String(p.id), p]),
  );
  const DEFAULTS = { remainingBudget: 100, waiverBudget: 20, roster: [] };
  const liveTeams = {}; // teamId -> {name, remainingBudget, waiverBudget, roster}
  let anyLive = false;

  function renderInjuryWire() {
    const feed = document.getElementById('injuryWireFeed');
    if (!feed) return;
    const items = [];
    for (const t of seedTeams) {
      const live = liveTeams[t.id] || DEFAULTS;
      for (const p of live.roster) {
        const news = playersNews.get(String(p.playerId));
        if (news) items.push({ team: t.name, ...news });
      }
    }
    feed.innerHTML = items.length
      ? items.slice(0, 5).map((n) => `
          <div class="tweet-card">
            <div class="tweet-avatar" style="background:#E8543F">${n.pos}</div>
            <div class="tweet-body">
              <div class="tweet-meta"><span class="tweet-name">${n.name}</span><span class="tweet-handle">${n.club} &middot; owned by ${n.team}</span></div>
              <div class="tweet-text">${n.news}</div>
            </div>
          </div>
        `).join('')
      : '<p class="empty-note">No injury concerns for owned players right now.</p>';
  }

  function timeAgo(date) {
    const secs = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
    if (secs < 60) return 'just now';
    if (secs < 3600) return `${Math.floor(secs / 60)}m ago`;
    if (secs < 86400) return `${Math.floor(secs / 3600)}h ago`;
    return `${Math.floor(secs / 86400)}d ago`;
  }

  function renderSquadMoves(docs) {
    const feed = document.getElementById('squadMovesFeed');
    if (!feed) return;
    if (!docs.length) {
      feed.innerHTML = '<p class="empty-note">No moves logged yet — they\'ll appear here the moment the admin makes one.</p>';
      return;
    }
    feed.innerHTML = docs.map((d) => {
      if (d.type === 'trade') {
        const aNames = (d.playersAToB || []).map((p) => p.name).join(', ') || 'nothing';
        const bNames = (d.playersBToA || []).map((p) => p.name).join(', ') || 'nothing';
        const budgetBits = [];
        if (d.budgetAToB) budgetBits.push(`${d.budgetAToB}m to ${d.teamBName}`);
        if (d.budgetBToA) budgetBits.push(`${d.budgetBToA}m to ${d.teamAName}`);
        const budgetNote = budgetBits.length ? ` Plus ${budgetBits.join(' and ')}.` : '';
        const when = d.ts ? timeAgo(d.ts.toDate()) : 'just now';
        return `
          <div class="tweet-card">
            <div class="tweet-avatar" style="background:#FFB627">${d.teamAName.slice(0, 2).toUpperCase()}</div>
            <div class="tweet-body">
              <div class="tweet-meta">
                <span class="tweet-name">Trade Confirmed</span>
                <span class="tweet-check">&#10003;</span>
                <span class="tweet-handle">Squad News</span>
                <span class="tweet-time">${when}</span>
              </div>
              <div class="tweet-text">${d.teamAName} send ${aNames} to ${d.teamBName} in exchange for ${bNames}.${budgetNote}</div>
            </div>
          </div>
        `;
      }
      const isRemove = d.type === 'remove';
      const verb = isRemove ? 'release' : 'sign';
      const color = isRemove ? '#E8543F' : '#37C871';
      const when = d.ts ? timeAgo(d.ts.toDate()) : 'just now';
      return `
        <div class="tweet-card">
          <div class="tweet-avatar" style="background:${color}">${d.teamName.slice(0, 2).toUpperCase()}</div>
          <div class="tweet-body">
            <div class="tweet-meta">
              <span class="tweet-name">${d.teamName}</span>
              <span class="tweet-check">&#10003;</span>
              <span class="tweet-handle">Squad News</span>
              <span class="tweet-time">${when}</span>
            </div>
            <div class="tweet-text">${d.teamName} ${verb} ${d.playerName}${isRemove ? '' : ` for ${d.price}m`}.</div>
          </div>
        </div>
      `;
    }).join('');
  }

  let draftLogInitialized = false;
  onSnapshot(query(collection(db, 'draftLog'), orderBy('ts', 'desc'), limit(3)), (snap) => {
    renderSquadMoves(snap.docs.map((d) => d.data()));
    if (!draftLogInitialized) {
      // Skip reacting to the batch of moves that already existed on page load —
      // only genuinely new ones (added after this point) should trigger a live post.
      draftLogInitialized = true;
      return;
    }
    snap.docChanges().forEach((change) => {
      if (change.type === 'added') (window as any).reactToMove?.(change.doc.data());
    });
  });

  function renderLiveScoreFor(teamId) {
    const live = liveTeams[teamId] || DEFAULTS;
    const breakdownEl = document.getElementById(`breakdown-${teamId}`);
    let total = 0;
    if (breakdownEl) {
      breakdownEl.innerHTML = live.roster.length
        ? live.roster.map((p) => {
            const pts = playerPoints.get(String(p.playerId)) ?? 0;
            total += pts;
            return `<li><span>${p.name}</span><span class="pts">${pts}</span></li>`;
          }).join('')
        : '<li class="empty-note">Squad not drafted yet.</li>';
    } else {
      total = live.roster.reduce((sum, p) => sum + (playerPoints.get(String(p.playerId)) ?? 0), 0);
    }
    return total;
  }

  function renderAllLiveScores() {
    document.querySelectorAll('[id^="live-score-"]').forEach((scoreEl) => {
      const [a, b] = scoreEl.id.replace('live-score-', '').split('-');
      const scoreA = renderLiveScoreFor(a);
      const scoreB = renderLiveScoreFor(b);
      scoreEl.textContent = `${scoreA} – ${scoreB}`;
    });
  }

  function renderTeamCard(teamId, data) {
    const budgetEl = document.getElementById(`budget-${teamId}`);
    const rosterEl = document.getElementById(`roster-${teamId}`);
    if (budgetEl) budgetEl.textContent = `${data.remainingBudget + data.waiverBudget}M`;
    if (rosterEl) {
      rosterEl.innerHTML = data.roster.length
        ? data.roster.map((p) => `<li><span>${p.name}</span><span>${p.price}m</span></li>`).join('')
        : '<li class="empty-note">Squad not drafted yet.</li>';
    }
  }

  function renderTicker() {
    const items = seedTeams.map((t) => {
      const live = liveTeams[t.id] || DEFAULTS;
      return `${t.name.toUpperCase()} &middot; ${live.remainingBudget + live.waiverBudget}M LEFT`;
    });
    const text = items.join(' &nbsp; / &nbsp; ');
    const el = document.getElementById('tickerText');
    if (el) el.innerHTML = text + ' &nbsp; / &nbsp; ' + text;
  }

  function refreshDraftedStatus() {
    const draftedIds = new Set();
    for (const t of seedTeams) {
      const live = liveTeams[t.id] || DEFAULTS;
      for (const p of live.roster) {
        if (p.playerId != null) draftedIds.add(String(p.playerId));
      }
    }
    let unpicked = 0;
    document.querySelectorAll('#playersBody tr').forEach((row) => {
      const pid = row.dataset.playerId;
      const isDrafted = pid && draftedIds.has(pid);
      row.dataset.drafted = isDrafted ? '1' : '0';
      if (!isDrafted) unpicked++;
    });
    const countEl = document.getElementById('unpickedCount');
    if (countEl) countEl.textContent = String(unpicked);
    (window as any).updateRowVisibility?.();
  }

  seedTeams.forEach((t) => {
    onSnapshot(doc(db, 'teams', String(t.id)), (snap) => {
      const data = snap.exists() ? snap.data() : { ...DEFAULTS, name: t.name };
      liveTeams[t.id] = data;
      if (snap.exists() && data.roster && data.roster.length) anyLive = true;
      renderTeamCard(t.id, data);
      renderTicker();
      refreshDraftedStatus();
      renderAllLiveScores();
      renderInjuryWire();
      const banner = document.getElementById('draftLiveBanner');
      if (banner) banner.style.display = anyLive ? 'flex' : 'none';
    });
  });
</script>
</body>
</html>

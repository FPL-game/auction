<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('nav.tabs button');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.page').forEach((p) => p.classList.remove('active'));
      document.getElementById('page-' + btn.dataset.page)?.classList.add('active');
    });
  });

  const searchInput = document.getElementById('playerSearch') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#playersBody tr'));
  const noPlayersNote = document.getElementById('noPlayersNote');

  function updateRowVisibility() {
    const f = (searchInput?.value || '').trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const matchesSearch = !f || (row.dataset.search || '').includes(f);
      const isUnpicked = row.dataset.drafted !== '1';
      const show = matchesSearch && isUnpicked;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (noPlayersNote) noPlayersNote.style.display = visible ? 'none' : '';
  }
  (window as any).updateRowVisibility = updateRowVisibility;
  searchInput?.addEventListener('input', updateRowVisibility);

  // ---- Players tab: sort by any FPL stat, mirroring FPL's own "sort by" list ----
  const PLAYER_SORT_LABELS: Record<string, string> = {
    pts: 'Total points', eventPoints: 'Gameweek points', selectedByPercent: 'Teams selected by %',
    minutes: 'Minutes played', goalsScored: 'Goals scored', assists: 'Assists',
    cleanSheets: 'Clean sheets', goalsConceded: 'Goals conceded', ownGoals: 'Own goals',
    penaltiesSaved: 'Penalties saved', penaltiesMissed: 'Penalties missed', yellowCards: 'Yellow cards',
    redCards: 'Red cards', saves: 'Saves', bonus: 'Bonus points', bps: 'Bonus Points System',
    influence: 'Influence', creativity: 'Creativity', threat: 'Threat', lastSeasonPts: "Last season's points",
  };
  function formatStatValueClient(key: string, val: any) {
    if (val == null) return '—';
    if (key === 'selectedByPercent') return `${Number(val).toFixed(1)}%`;
    if (key === 'influence' || key === 'creativity' || key === 'threat') return Number(val).toFixed(1);
    return String(val);
  }
  const sortSelect = document.getElementById('playerSortSelect') as HTMLSelectElement | null;
  const statColHeader = document.getElementById('statColHeader');
  function applyPlayerSort() {
    const key = sortSelect?.value || 'pts';
    const tbody = document.getElementById('playersBody');
    if (!tbody) return;
    const sorted = [...rows].sort((a, b) => {
      const sa = JSON.parse(a.dataset.stats || '{}')[key];
      const sb = JSON.parse(b.dataset.stats || '{}')[key];
      return (sb ?? -Infinity) - (sa ?? -Infinity);
    });
    sorted.forEach((row) => {
      const stats = JSON.parse(row.dataset.stats || '{}');
      const cell = row.querySelector('.stat-cell');
      if (cell) cell.textContent = formatStatValueClient(key, stats[key]);
      tbody.appendChild(row);
    });
    if (statColHeader) statColHeader.textContent = PLAYER_SORT_LABELS[key] || key;
  }
  sortSelect?.addEventListener('change', applyPlayerSort);
</script>


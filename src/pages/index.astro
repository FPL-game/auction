---
import auctionLeagueData from "../data/auctionLeague.json";
import { computeStandings, teamName } from "../lib/auctionLeagueUtils.mjs";

const state = auctionLeagueData as any;
const { teams, fixtures, results, players, meta, liveScores } = state;
const livePlayerPoints = state.livePlayerPoints || {};
// Generated fresh every sync run (scripts/update-fpl-data.mjs) from real current
// data — unpicked players, budgets, rosters. Empty until the first sync after this
// feature ships.
const rumours = state.rumours || [];

// Real Premier League fixtures (not this fantasy league's own fixtures) — clubFixtures is
// a short per-club lookahead for the Players tab's difficulty ticker, plMatches is the
// full upcoming list for the standalone PL Matches tab. Both only ever contain fixtures
// FPL hasn't marked finished yet, so a gameweek disappears on its own once it's over —
// nothing here needs manual cleanup.
const clubFixtures = state.clubFixtures || {};
const plMatches = state.plMatches || [];
const plMatchesByGw = new Map<number, any[]>();
for (const m of plMatches) {
  if (!plMatchesByGw.has(m.gw)) plMatchesByGw.set(m.gw, []);
  plMatchesByGw.get(m.gw)!.push(m);
}

// FPL's Fixture Difficulty Rating is 1 (easiest) to 5 (hardest) — mapped onto the site's
// existing turf/grey/red palette rather than FPL's own green-to-red scale, so it reads as
// part of this site rather than a copy of the official one.
function fdrClass(difficulty: number) {
  if (difficulty <= 2) return "fdr-easy";
  if (difficulty >= 4) return "fdr-hard";
  return "fdr-medium";
}

// FPL's own player headshot CDN, keyed on the `code` field (not the element id). Falls
// back to FPL's own generic "no photo" shirt graphic both here (a missing code) and via
// each <img>'s onerror (a code that has no actual headshot on the CDN — common for
// fringe/lower-profile players, and not something knowable in advance from the data).
const MISSING_PHOTO_URL = "https://resources.premierleague.com/premierleague/photos/players/110x140/Photo-Missing.png";
function playerPhotoUrl(code: any) {
  return code
    ? `https://resources.premierleague.com/premierleague/photos/players/110x140/p${code}.png`
    : MISSING_PHOTO_URL;
}
const photoOnError = `this.onerror=null;this.src='${MISSING_PHOTO_URL}';`;

function formatKickoff(iso: string) {
  const d = new Date(iso);
  const weekday = d.toLocaleDateString("en-GB", { weekday: "short", timeZone: "UTC" });
  const day = d.toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
  const time = d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" });
  return `${weekday} ${day}, ${time} UTC`;
}

// Sortable stats on the Players tab — mirrors FPL's own "sort by" list (minus price,
// which this league doesn't track per-player in the same way). Each stat already sits
// on the player object from scripts/update-fpl-data.mjs except lastSeasonPts, which is
// fetched incrementally there and may briefly read null for a player it hasn't gotten to
// yet. "value" is the key on each player object; every option sorts descending, same as
// FPL's own tool (e.g. "goals conceded" surfaces who's conceded the MOST first).
const PLAYER_SORT_OPTIONS = [
  { value: "pts", label: "Total points" },
  { value: "eventPoints", label: "Gameweek points" },
  { value: "selectedByPercent", label: "Teams selected by %" },
  { value: "minutes", label: "Minutes played" },
  { value: "goalsScored", label: "Goals scored" },
  { value: "assists", label: "Assists" },
  { value: "cleanSheets", label: "Clean sheets" },
  { value: "goalsConceded", label: "Goals conceded" },
  { value: "ownGoals", label: "Own goals" },
  { value: "penaltiesSaved", label: "Penalties saved" },
  { value: "penaltiesMissed", label: "Penalties missed" },
  { value: "yellowCards", label: "Yellow cards" },
  { value: "redCards", label: "Red cards" },
  { value: "saves", label: "Saves" },
  { value: "bonus", label: "Bonus points" },
  { value: "bps", label: "Bonus Points System" },
  { value: "influence", label: "Influence" },
  { value: "creativity", label: "Creativity" },
  { value: "threat", label: "Threat" },
  { value: "lastSeasonPts", label: "Last season's points" },
];

function formatStatValue(key: string, val: any) {
  if (val == null) return "—";
  if (key === "selectedByPercent") return `${val.toFixed(1)}%`;
  if (key === "influence" || key === "creativity" || key === "threat") return val.toFixed(1);
  return String(val);
}

const standings = computeStandings(teams, results);

// Roster and live-score-breakdown entries only carry a player's id (as `playerId`), not
// their FPL `code` — this cross-references back into the full player pool for photos.
const codeByPlayerId = new Map(players.map((p: any) => [p.id, p.code]));

const tickerItems = teams.map(
  (t: any) => `${t.name.toUpperCase()} &middot; ${t.remainingBudget + t.waiverBudget}M LEFT`,
);
const tickerText = tickerItems.join(" &nbsp; / &nbsp; ");

const unpickedCount = players.filter((p: any) => p.draftedBy === null).length;

function pick(arr: any[]) {
  return arr[Math.floor(Math.random() * arr.length)];
}

// ---- Live Scores tab: once a gameweek has a result, that result is authoritative ----
// state.liveScores only covers a gameweek while it's actively in progress — once it's
// done (even just provisionally, before FPL's data_checked confirms bonus points), this
// script's own results-finalize loop is the only source of truth. Without this, the tab
// would fall back to summing each rostered player's ever-changing live/season points
// (scripts/update-fpl-data.mjs's gwScoreForRoster is snapshot-protected, but the client's
// own fallback wasn't) — which drifts for two independent reasons even with zero roster
// changes: FPL keeps correcting provisional bonus points for days after a match, and any
// transfer after the gameweek would swap in a different roster entirely. Every match for
// the currently-displayed gameweek that already has a stored result uses that result's
// score and per-player breakdown, frozen, from here on.
const currentGwFixture = fixtures.find((f: any) => f.gw === meta.currentGameweek) || fixtures[0];
const finalMatchesForCurrentGw = (currentGwFixture?.matches || [])
  .map(([a, b]: [number, number]) => {
    const res = results[`${meta.currentGameweek}-${a}-${b}`];
    if (!res) return null;
    return { a, b, scoreA: res.scoreA, scoreB: res.scoreB, breakdownA: res.breakdownA || null, breakdownB: res.breakdownB || null };
  })
  .filter((m: any) => m !== null);

// ---- Match Day Recap: most recently completed gameweek, from real results ----
const playedGws = Object.keys(results).map((k: string) => Number(k.split("-")[0]));
const latestGw = playedGws.length ? Math.max(...playedGws) : null;
const latestGwFixture = latestGw ? fixtures.find((f: any) => f.gw === latestGw) : null;
const latestRecaps = (latestGwFixture?.matches || [])
  .map(([a, b]: [number, number]) => {
    const res = results[`${latestGw}-${a}-${b}`];
    if (!res) return null;
    const winner = res.scoreA > res.scoreB ? a : res.scoreB > res.scoreA ? b : null;
    const margin = Math.abs(res.scoreA - res.scoreB);
    return {
      a, b, scoreA: res.scoreA, scoreB: res.scoreB, winner, margin,
      topScorerA: res.topScorerA || null,
      topScorerB: res.topScorerB || null,
    };
  })
  .filter((r: any) => r !== null);

// A snarky, multi-sentence recap paragraph rather than a single flat line — leans on the
// real per-player top scorer for each side (captured at finalize time in the sync script)
// wherever it's available, so the banter is grounded in what actually happened, not just
// the final score. Randomised per site build (like the Social Media feed) so the copy
// varies gameweek to gameweek even for similar-shaped results.
function starLine(top: any, teamLabel: string) {
  return top ? ` ${top.name} led the way for ${teamLabel} with ${top.points} points.` : "";
}

function recapParagraph(r: any) {
  const teamAName = teamName(teams, r.a);
  const teamBName = teamName(teams, r.b);

  if (r.winner === null) {
    const starA = r.topScorerA ? ` ${r.topScorerA.name} (${r.topScorerA.points} pts) did the heavy lifting for ${teamAName}` : "";
    const starB = r.topScorerB ? `${starA ? " while" : ""} ${r.topScorerB.name} (${r.topScorerB.points} pts) matched them stride for stride for ${teamBName}` : "";
    return `Honours even between ${teamAName} and ${teamBName} — ${r.scoreA} apiece, and nobody in this league is happy about it.${starA}${starB}. A draw settles nothing and everyone knows it.`;
  }

  const winnerName = teamName(teams, r.winner);
  const loserName = teamName(teams, r.winner === r.a ? r.b : r.a);
  const topWinner = r.winner === r.a ? r.topScorerA : r.topScorerB;
  const topLoser = r.winner === r.a ? r.topScorerB : r.topScorerA;
  const scoreHigh = Math.max(r.scoreA, r.scoreB);
  const scoreLow = Math.min(r.scoreA, r.scoreB);

  let templates: string[];
  if (r.margin >= 40) {
    templates = [
      `${winnerName} didn't just beat ${loserName}, they took the scenic route through their entire lineup and back — ${scoreHigh}-${scoreLow}.${starLine(topWinner, winnerName)} ${loserName} FC fans have already muted the group chat.`,
      `Brutal. ${winnerName} put ${r.margin} points between themselves and ${loserName}, which in this league counts as a public execution.${starLine(topWinner, winnerName)}${topLoser ? ` Even ${topLoser.name}'s ${topLoser.points} points for ${loserName} barely registered.` : ""} ${loserName}, we'll see you at the next waiver deadline — you clearly need it.`,
    ];
  } else if (r.margin >= 20) {
    templates = [
      `${winnerName} controlled this one from start to finish, seeing off ${loserName} ${scoreHigh}-${scoreLow} with room to spare.${starLine(topWinner, winnerName)} ${loserName} FC ultras are already drafting their excuses for the group chat.`,
      `A comfortable week for ${winnerName}, who beat ${loserName} ${scoreHigh}-${scoreLow} without ever looking troubled.${starLine(topWinner, winnerName)} Nothing to see here — except ${loserName} quietly reconsidering their whole squad.`,
    ];
  } else if (r.margin <= 5) {
    templates = [
      `${winnerName} survive a genuine heart-attack of a gameweek, edging out ${loserName} ${scoreHigh}-${scoreLow} by the width of a crossbar.${starLine(topWinner, winnerName)} ${loserName} will be replaying every single substitution decision in their head for a week.`,
      `Margins don't get much finer than this — ${winnerName} nick it off ${loserName} ${scoreHigh}-${scoreLow}, just ${r.margin} agonising point${r.margin === 1 ? "" : "s"} between them.${starLine(topWinner, winnerName)} Somebody in ${loserName}'s camp is not sleeping tonight.`,
    ];
  } else {
    templates = [
      `${winnerName} get the better of ${loserName} ${scoreHigh}-${scoreLow} in a solid, professional week's work.${starLine(topWinner, winnerName)}${topLoser ? ` ${topLoser.name} tried to drag ${loserName} back into it with ${topLoser.points} points, but it wasn't enough.` : ""} ${loserName} FC fans, there's always next Gameweek.`,
      `Not a classic, but ${winnerName} do what they needed to against ${loserName}, ${scoreHigh}-${scoreLow}.${starLine(topWinner, winnerName)} ${loserName} will point to the bigger picture. ${winnerName} will point to the table.`,
    ];
  }
  return pick(templates);
}

// ---- Injury Wire source data (players with real FPL news, for owned-player cross-reference client-side) ----
const playersWithNews = players
  .filter((p: any) => p.news && p.news.trim().length > 0)
  .map((p: any) => ({ id: p.id, name: p.name, pos: p.pos, club: p.club, news: p.news }));

// ---- Homepage section order ----
// Default (pre-season, and any day outside the recap window below): Social Media leads,
// since Squad Moves/Injury Wire/Match Recap are thin or stale most of the time.
// For a day after a Gameweek finishes (state.meta.gwFinalizedAt, stamped by the sync
// script the moment a GW's results first go fully final): Match Recap leads instead,
// followed by Social Media, with Squad Moves and Injury Wire pushed below — that's the
// one window where the recap is genuinely the most interesting thing on the page.
const gwFinalizedAt = (meta?.gwFinalizedAt || {}) as Record<string, string>;
const latestGwFinalizedAt = latestGw !== null ? gwFinalizedAt[String(latestGw)] : null;
const recapWindowActive = !!latestGwFinalizedAt
  && (Date.now() - new Date(latestGwFinalizedAt).getTime()) < 24 * 60 * 60 * 1000;

const ORDER = recapWindowActive
  ? { matchRecap: 1, social: 2, squadMoves: 3, injuryWire: 4 }
  : { social: 1, squadMoves: 2, injuryWire: 3, matchRecap: 4 };

const FAQ = [
  { cat: "The Basics", items: [
    ["How does the draft work?", "Everyone bids live on players, one at a time, until all 6 squads are full. It's a real auction — whoever bids highest gets the player, no snake-draft turns."],
    ["What's the budget?", "Everyone starts with 100m to build an 11-player squad. Spend it however you like — there's no rule on how much to spend per position."],
    ["Do I need a specific formation?", "No. The only rule is 1 goalkeeper. The other 10 spots can be any mix of defenders, midfielders and forwards you want."],
    ["Can two teams own the same player?", "No. Once a player is bought, they're off the market for everyone else all season."],
    ["Is there a bench?", "No bench. All 11 players you own are your starting XI every Gameweek. If one of them doesn't play, you just take the zero."],
  ]},
  { cat: "Scoring & The Table", items: [
    ["How are points calculated?", "Standard FPL points — whatever each player scores in real Fantasy Premier League that Gameweek is what counts for your team."],
    ["Do captains or chips apply?", "No captaincy and no chips (no Wildcard, Bench Boost, Triple Captain, Free Hit). Just your 11 players' raw points added up."],
    ["How do fixtures work?", "One match per Gameweek slot, just like real Premier League weekends — 3 games happen simultaneously each GW, and every team plays every other team once every 5 Gameweeks, repeating all season."],
    ["How do I win a match?", "Whoever's 11 players score more total points that Gameweek wins. 3 points for a win, 1 each for a draw, 0 for a loss."],
    ["How are ties on the table broken?", "First by total points scored across the season, then by points differential (points for minus points against)."],
  ]},
  { cat: "Transfers & Waivers", items: [
    ["Can I change my squad during the season?", "Yes. You can release a player any time (no fee) and replace them through a mini-bidding process."],
    ["How does replacing a player work?", "You announce who you're releasing. That opens a 24-hour window where anyone — including you — can bid to bring in the replacement."],
    ["What do I bid with?", "A separate waiver budget: 20m per team, plus whatever you didn't spend from your original 100m draft budget."],
    ["When can transfers happen?", "Any time, except during a locked window — from 6 hours before the first game of a Gameweek until that Gameweek finishes."],
    ["Can a transfer be blocked?", "Yes. If 2 or more of the 6 managers vote that a transfer is unfair, it's overturned."],
  ]},
  { cat: "Admin", items: [
    ["Who runs the league?", "Claude keeps the live leaderboard on this site and syncs real FPL scores automatically every 2 hours during Gameweeks, so anything can be corrected quickly if there's a mistake."],
    ["Where do I check live scores?", "The Live Scores tab — it reflects the current Gameweek's matches based on real FPL data as it comes in."],
  ]},
];
---

<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Auction League</title>
<meta name="description" content="A 6-manager FPL auction draft mini-league — rosters, fixtures, standings and live scores." />
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --pitch: #0B0F1A;
    --pitch-2: #121A2C;
    --card: #151D30;
    --card-2: #1C2640;
    --line: #2B3654;
    --turf: #4A90D9;
    --turf-dim: #2C5C8A;
    --amber: #C9A227;
    --white: #EDEFF5;
    --grey: #8892A6;
    --red: #E15554;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background: radial-gradient(ellipse at top, #1A2740 0%, var(--pitch) 55%);
    color: var(--white);
    font-family: 'Work Sans', sans-serif;
    min-height: 100vh;
    padding-bottom: 60px;
  }
  .mono{ font-family:'JetBrains Mono', monospace; }
  .display{ font-family:'Poppins', sans-serif; text-transform:uppercase; letter-spacing:0.02em; }

  .ticker-wrap{
    background: var(--turf);
    color: var(--pitch);
    overflow:hidden;
    white-space:nowrap;
    border-bottom: 2px solid var(--pitch);
  }
  .ticker{
    display:inline-block;
    padding: 6px 0;
    animation: scroll-left 28s linear infinite;
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  @keyframes scroll-left{
    0%{ transform: translateX(0%); }
    100%{ transform: translateX(-50%); }
  }

  header.top{
    padding: 28px 24px 0;
    max-width: 1100px;
    margin: 0 auto;
  }
  .brand{
    display:flex;
    align-items:baseline;
    gap: 12px;
    flex-wrap:wrap;
  }
  .brand h1{
    font-size: clamp(32px, 6vw, 56px);
    color: var(--white);
    line-height: 0.95;
  }
  .brand h1 em{
    font-style:normal;
    background: linear-gradient(90deg, var(--turf), var(--amber));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .brand .sub{ color: var(--grey); font-size: 13px; letter-spacing:0.05em; text-transform:uppercase; font-family:'JetBrains Mono', monospace; }

  nav.tabs{
    max-width: 1100px;
    margin: 22px auto 0;
    padding: 0 24px;
    display:flex;
    gap: 4px;
    flex-wrap: wrap;
    border-bottom: 2px solid var(--line);
  }
  nav.tabs button{
    background: transparent;
    border: none;
    color: var(--grey);
    font-family:'Poppins', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 14px;
    padding: 12px 16px;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  nav.tabs button:hover{ color: var(--white); }
  nav.tabs button.active{ color: var(--turf); border-bottom-color: var(--turf); }

  main{
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px 0;
  }
  .page{ display:none; animation: fade-in 0.25s ease; }
  .page.active{ display:block; }
  @keyframes fade-in{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);} }

  .section-eyebrow{
    color: var(--turf);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .section-title{
    font-size: clamp(22px, 4vw, 32px);
    margin-bottom: 20px;
  }

  .team-grid{
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .team-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 20px;
    position: relative;
    overflow: hidden;
  }
  .team-card::before{
    content: attr(data-num);
    position:absolute;
    right: 12px; top: -6px;
    font-family:'Poppins', sans-serif;
    font-size: 64px;
    color: var(--line);
    opacity:0.5;
    line-height:1;
  }
  .team-card h3{
    font-family:'Poppins', sans-serif;
    text-transform:uppercase;
    font-size: 22px;
    letter-spacing:0.02em;
    color: var(--white);
    position:relative;
  }
  .team-card .tag{
    color:var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    margin-bottom: 14px;
    display:block;
  }
  .budget-row{
    display:flex;
    gap: 10px;
    margin-bottom: 14px;
  }
  .budget-pill{
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 8px 12px;
    flex:1;
  }
  .budget-pill .num{
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size: 18px;
    color: var(--turf);
  }
  .budget-pill .lbl{
    font-size: 10px;
    color: var(--grey);
    text-transform:uppercase;
    letter-spacing:0.08em;
  }
  .roster-list{
    list-style:none;
    border-top: 1px dashed var(--line);
    padding-top: 10px;
  }
  .roster-list li{
    display:flex;
    justify-content:space-between;
    padding: 5px 0;
    font-size: 13px;
    color: var(--white);
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .roster-list li .pos{
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size:11px;
    margin-right: 8px;
  }
  .empty-note{
    color: var(--grey);
    font-size: 13px;
    font-style: italic;
    padding: 10px 0;
  }

  .news-wire-stack{
    display: flex;
    flex-direction: column;
  }
  .news-block{
    margin-bottom: 32px;
  }
  .news-block-head{
    display:flex;
    align-items:center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .news-block-title{
    font-family:'Poppins', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 18px;
    color: var(--white);
  }
  .news-block-tag{
    font-family:'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--grey);
    background: var(--card-2);
    border: 1px solid var(--line);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .news-block-tag.live-tag{ color: var(--turf); border-color: var(--turf); }
  .news-block-tag.provisional-tag{ color: var(--amber); border-color: var(--amber); }
  .match-row .vs.score{
    color: var(--white);
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size: 15px;
    padding: 0 14px;
  }

  .fdr-row{ display:flex; gap:4px; flex-wrap:nowrap; }
  .fdr-box{
    font-family:'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight:700;
    text-align:center;
    padding: 3px 5px;
    border-radius: 4px;
    white-space:nowrap;
    color: var(--white);
  }
  .fdr-box.fdr-easy{ background: var(--turf-dim); }
  .fdr-box.fdr-medium{ background: var(--card-2); border: 1px solid var(--line); color: var(--grey); }
  .fdr-box.fdr-hard{ background: var(--red); }
  .pl-match-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: 12px;
    padding: 10px 4px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .pl-match-row .pl-date{
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    min-width: 150px;
  }
  .pl-match-row .pl-teams{ flex:1; text-align:right; }
  .recap-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px 18px;
    margin-bottom: 10px;
  }
  .recap-teams{
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size: 15px;
    color: var(--white);
    margin-bottom: 6px;
  }
  .recap-winner{ color: var(--turf); }
  .recap-vs{ color: var(--grey); margin: 0 8px; }
  .recap-flavor{ color: var(--grey); font-size: 13px; }

  .rumours-section{
    margin-bottom: 32px;
  }
  .rumours-head{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    margin-bottom: 14px;
  }
  .rumours-refresh{
    background: transparent;
    border: 1px solid var(--line);
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
  }
  .rumours-refresh:hover{ color: var(--white); border-color: var(--turf); }
  .tweet-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 10px;
    display:flex;
    gap: 12px;
  }
  .tweet-avatar{
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .tweet-body{ flex: 1; min-width: 0; }
  .tweet-meta{
    display:flex;
    align-items:baseline;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 3px;
  }
  .tweet-name{ font-weight:700; font-size: 13px; color: var(--white); }
  .tweet-check{ color: var(--turf); font-size: 12px; }
  .tweet-handle{ color: var(--grey); font-size: 12px; font-family:'JetBrains Mono', monospace; }
  .tweet-time{ color: var(--grey); font-size: 11px; font-family:'JetBrains Mono', monospace; margin-left: auto; }
  .tweet-text{ font-size: 13px; line-height: 1.5; color: var(--white); }
  .rumours-disclaimer{
    color: var(--grey);
    font-size: 11px;
    font-style: italic;
    margin-top: 10px;
  }

  .gw-block{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 10px;
  }
  .gw-block summary{
    cursor:pointer;
    font-family:'Poppins', sans-serif;
    text-transform:uppercase;
    font-size: 16px;
    color: var(--turf);
    letter-spacing:0.03em;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .gw-block summary::-webkit-details-marker{ display:none; }
  .gw-block summary .chevron{ color: var(--grey); font-family:'JetBrains Mono',monospace; }
  .match-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 10px 4px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .match-row .side{ flex:1; }
  .match-row .side.right{ text-align:right; }
  .match-row .vs{
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 0 14px;
  }

  table.standings{
    width:100%;
    border-collapse: collapse;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow:hidden;
  }
  table.standings th{
    background: var(--card-2);
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing: 0.08em;
    padding: 12px 10px;
    text-align:left;
  }
  table.standings td{
    padding: 12px 10px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  table.standings tbody tr:nth-child(1) td:first-child{ color: var(--turf); font-weight:700; }
  .pts-col{ color: var(--amber); font-family:'JetBrains Mono', monospace; font-weight:700; }

  .live-banner{
    display:flex;
    align-items:center;
    gap:10px;
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 18px;
    font-family:'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--grey);
  }
  .live-dot{
    width:8px; height:8px; border-radius:50%;
    background: var(--red);
    animation: pulse 1.4s infinite;
    flex-shrink:0;
  }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:0.3;} }
  .score-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 14px;
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .score-card .team-name{
    font-family:'Poppins', sans-serif;
    text-transform:uppercase;
    font-size: 18px;
    flex:1;
  }
  .score-card .team-name.right{ text-align:right; }
  .score-card .score{
    font-family:'JetBrains Mono', monospace;
    font-size: 32px;
    font-weight:700;
    color: var(--turf);
    padding: 0 24px;
    min-width: 110px;
    text-align:center;
  }

  .match-meta{
    display: flex;
    justify-content: space-between;
    padding: 0 20px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--grey);
  }
  .match-meta-side{ display: flex; flex-direction: column; gap: 2px; }
  .match-meta-side.right{ text-align: right; align-items: flex-end; }
  .win-prob-bar{
    display: flex;
    height: 6px;
    margin: 0 20px 14px;
    background: var(--card-2);
    border-radius: 999px;
    overflow: hidden;
  }
  .win-prob-fill-a{ height: 100%; background: var(--turf); }
  .win-prob-fill-b{ height: 100%; background: var(--amber); }

  .score-card-wrap{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    margin-bottom: 14px;
    overflow: hidden;
  }
  .score-card-wrap .score-card{
    margin-bottom: 0;
    border-radius: 0;
    border: none;
  }
  .score-breakdown{
    display:flex;
    border-top: 1px solid var(--line);
  }
  .score-breakdown details{
    flex: 1;
    padding: 10px 16px;
  }
  .score-breakdown details:first-child{
    border-right: 1px solid var(--line);
  }
  .score-breakdown summary{
    cursor:pointer;
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color: var(--grey);
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .score-breakdown summary::-webkit-details-marker{ display:none; }
  .score-breakdown summary .chevron{ font-family:'JetBrains Mono', monospace; }
  .breakdown-list{
    list-style:none;
    padding-top: 8px;
  }
  .breakdown-list li{
    display:flex;
    justify-content:space-between;
    padding: 4px 0;
    font-size: 13px;
  }
  .breakdown-list .pts{
    font-family:'JetBrains Mono', monospace;
    color: var(--turf);
  }

  .search-row{ margin-bottom: 16px; display:flex; gap:10px; flex-wrap:wrap; }
  .search-row input{
    flex: 2;
    min-width: 200px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 14px;
    color: var(--white);
    font-family:'Work Sans', sans-serif;
    font-size: 14px;
  }
  .search-row .sort-select{
    flex: 1;
    min-width: 180px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 14px;
    color: var(--white);
    font-family:'Work Sans', sans-serif;
    font-size: 14px;
  }
  .table-scroll{ overflow-x:auto; }
  table.players{
    width:100%;
    min-width: 640px;
    border-collapse: collapse;
  }
  table.players th{
    text-align:left;
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing:0.08em;
    padding: 8px 10px;
    border-bottom: 2px solid var(--line);
  }
  table.players td{
    padding: 9px 10px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  table.players tr:hover td{ background: var(--card-2); }
  .pos-badge{
    font-family:'JetBrains Mono', monospace;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--card-2);
    color: var(--turf);
    border: 1px solid var(--line);
  }
  .drafted-badge{
    font-family:'JetBrains Mono', monospace;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(233,0,82,0.12);
    color: var(--amber);
    border: 1px solid var(--line);
  }

  .faq-item{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    margin-bottom: 10px;
    overflow:hidden;
  }
  .faq-item summary{
    cursor:pointer;
    padding: 16px 18px;
    font-weight:600;
    font-size: 15px;
    color: var(--white);
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .faq-item summary::-webkit-details-marker{ display:none; }
  .faq-item summary .plus{
    font-family:'JetBrains Mono', monospace;
    color: var(--turf);
    font-size: 18px;
  }
  .faq-item p{
    padding: 0 18px 18px;
    color: var(--grey);
    font-size: 14px;
    line-height: 1.6;
  }
  .faq-cat{
    color: var(--amber);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing: 0.12em;
    margin: 26px 0 10px;
  }
  .faq-cat:first-child{ margin-top: 0; }

  footer{
    max-width:1100px;
    margin: 40px auto 0;
    padding: 20px 24px;
    color: var(--grey);
    font-size: 12px;
    font-family:'JetBrains Mono', monospace;
    border-top: 1px solid var(--line);
  }

  .player-photo{
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    background: var(--card-2);
    border: 1px solid var(--line);
    flex-shrink: 0;
  }
  .player-cell{
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    border-radius: 6px;
  }
  .player-cell::after{
    content: '\203a';
    color: var(--grey);
    opacity: 0.55;
    font-size: 15px;
    font-weight: 700;
    margin-left: 1px;
  }
  .player-cell:hover, .player-cell:focus-visible{
    background: var(--card-2);
    outline: none;
  }
  .player-cell:hover::after, .player-cell:focus-visible::after{
    opacity: 1;
    color: var(--turf);
  }

  .player-modal-backdrop{
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 100;
    padding: 20px;
    overflow-y: auto;
  }
  .player-modal-backdrop.open{ display: flex; align-items: flex-start; justify-content: center; }
  .player-modal{
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px;
    max-width: 420px;
    width: 100%;
    margin-top: 40px;
  }
  .player-modal-close{
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--card-2);
    border: 1px solid var(--line);
    color: var(--grey);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }
  .player-modal-head{
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .player-modal-photo{
    width: 64px;
    height: 82px;
    object-fit: cover;
    object-position: top center;
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    flex-shrink: 0;
  }
  .player-modal-name{ font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 18px; }
  .player-modal-sub{ color: var(--grey); font-size: 13px; margin-top: 2px; }
  .player-modal-news{ color: var(--amber); font-size: 12px; margin-top: 6px; }
  .player-modal-headline{
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin: 16px 0;
    padding: 12px;
    background: var(--card-2);
    border-radius: 8px;
    text-align: center;
  }
  .player-modal-headline .stat{ flex: 1; }
  .player-modal-headline .stat .num{ font-family: 'JetBrains Mono', monospace; font-size: 18px; color: var(--turf); }
  .player-modal-headline .stat .lbl{ font-size: 10px; color: var(--grey); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 2px; }
  .player-modal-stats{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }
  .player-modal-stats .row{ display: flex; justify-content: space-between; border-bottom: 1px solid var(--line); padding: 4px 0; }
  .player-modal-stats .row span:first-child{ color: var(--grey); }

  .matchday-stripe{
    height: 4px;
    background: linear-gradient(90deg, var(--turf), var(--amber), var(--turf));
  }

  @media (max-width:600px){
    nav.tabs{ overflow-x:auto; flex-wrap:nowrap; }
    .score-card{ flex-direction:column; gap:10px; }
    .score-card .score{ padding:0; }
  }
</style>
</head>
<body>

<div class="ticker-wrap">
  <div class="ticker" id="tickerText" set:html={tickerText + " &nbsp; / &nbsp; " + tickerText}></div>
</div>
<div class="matchday-stripe"></div>

<header class="top">
  <div class="brand">
    <h1>THE <em>AUCTION</em> LEAGUE</h1>
  </div>
  <div class="sub">6 managers &middot; 100M budget &middot; 38 gameweeks &middot; no mercy</div>
</header>

<nav class="tabs" id="tabs">
  <button data-page="home" class="active">Home</button>
  <button data-page="squads">Squads</button>
  <button data-page="fixtures">Fixtures</button>
  <button data-page="standings">Standings</button>
  <button data-page="live">Live Scores</button>
  <button data-page="players">Players</button>
  <button data-page="pl-matches">PL Matches</button>
  <button data-page="faq">FAQ</button>
</nav>

<main>

  <!-- HOME: NEWS WIRE -->
  <section class="page active" id="page-home">
    <div class="section-eyebrow">The Auction League</div>
    <div class="section-title">What's Happening</div>

    <div class="news-wire-stack">
      <div class="news-block" style={`order:${ORDER.squadMoves}`}>
        <div class="news-block-head">
          <span class="news-block-title">&#128260; Squad Moves</span>
          <span class="news-block-tag live-tag">Live</span>
        </div>
        <div id="squadMovesFeed"><p class="empty-note">No moves logged yet — they'll appear here the moment the admin makes one.</p></div>
      </div>

      <div class="news-block" style={`order:${ORDER.injuryWire}`}>
        <div class="news-block-head">
          <span class="news-block-title">&#129719; Injury Wire</span>
          <span class="news-block-tag">Real FPL data</span>
        </div>
        <div id="injuryWireFeed"><p class="empty-note">No injury concerns for owned players right now.</p></div>
      </div>

      <div class="news-block" style={`order:${ORDER.matchRecap}`}>
        <div class="news-block-head">
          <span class="news-block-title">&#128202; Match Day Recap</span>
          <span class="news-block-tag">{latestGw ? `Gameweek ${latestGw}` : "Season not underway"}</span>
        </div>
        {latestRecaps.length ? (
          <div>
            {latestRecaps.map((r: any) => (
              <div class="recap-card">
                <div class="recap-teams">
                  <span class={r.winner === r.a ? "recap-winner" : ""}>{teamName(teams, r.a)} {r.scoreA}</span>
                  <span class="recap-vs">&ndash;</span>
                  <span class={r.winner === r.b ? "recap-winner" : ""}>{r.scoreB} {teamName(teams, r.b)}</span>
                </div>
                <p class="recap-flavor">{recapParagraph(r)}</p>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-note">Recaps land here automatically once a Gameweek finishes — nothing to show yet.</p>
        )}
      </div>

      <div class="rumours-section" style={`order:${ORDER.social}`}>
        <div class="rumours-head">
          <div>
            <span class="news-block-title">&#128241; Social Media</span>
          </div>
          <button class="rumours-refresh" id="rumoursRefresh">&#8635; Refresh</button>
        </div>
        <div id="rumoursFeed"></div>
        <p class="rumours-disclaimer">Entirely made up for fun — not real posts, not real people, not real accounts.</p>
      </div>
    </div>
  </section>

  <!-- SQUADS -->
  <section class="page" id="page-squads">
    <div class="section-eyebrow">Squads</div>
    <div class="section-title">Team Rosters &amp; Budgets</div>
    <div class="live-banner" id="draftLiveBanner" style="display:none;"><span class="live-dot"></span> Draft is live &mdash; updating in real time.</div>
    <div class="team-grid">
      {teams.map((t: any, i: number) => (
        <div class="team-card" data-num={String(i + 1).padStart(2, "0")} data-team-id={t.id}>
          <span class="tag">Team {i + 1}</span>
          <h3>{t.name}</h3>
          <div class="budget-row">
            <div class="budget-pill"><div class="num" id={`budget-${t.id}`}>{t.remainingBudget + t.waiverBudget}M</div><div class="lbl">Budget Remaining</div></div>
          </div>
          <ul class="roster-list" id={`roster-${t.id}`}>
            {t.roster.length ? t.roster.map((p: any) => (
              <li>
                <span class="player-cell" data-player-id={p.playerId} tabindex="0">
                  <img class="player-photo" src={playerPhotoUrl(codeByPlayerId.get(p.playerId))} loading="lazy" alt="" onerror={photoOnError} />
                  {p.name}
                </span>
                <span>{p.price}m</span>
              </li>
            )) : <li class="empty-note">Squad not drafted yet.</li>}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FIXTURES -->
  <section class="page" id="page-fixtures">
    <div class="section-eyebrow">Season Schedule</div>
    <div class="section-title">All 38 Gameweeks</div>
    <div>
      {fixtures.map((gwObj: any) => {
        const gwResults = gwObj.matches.map(([a, b]: [number, number]) => results[`${gwObj.gw}-${a}-${b}`]);
        const gwPlayed = gwResults.some((r: any) => r);
        const gwFinal = gwResults.length > 0 && gwResults.every((r: any) => r?.final);
        return (
        <details class="gw-block">
          <summary>
            <span>Gameweek {gwObj.gw}</span>
            <span style="display:flex; align-items:center; gap:8px;">
              {gwFinal ? (
                <span class="news-block-tag live-tag">FT</span>
              ) : gwPlayed ? (
                <span class="news-block-tag provisional-tag">Provisional</span>
              ) : null}
              <span class="chevron">+</span>
            </span>
          </summary>
          {gwObj.matches.map(([a, b]: [number, number]) => {
            const res = results[`${gwObj.gw}-${a}-${b}`];
            return (
              <div class="match-row">
                <div class={`side ${res && res.scoreA > res.scoreB ? "recap-winner" : ""}`}>{teamName(teams, a)}</div>
                {res ? (
                  <div class="vs score">{res.scoreA} &ndash; {res.scoreB}</div>
                ) : (
                  <div class="vs">VS</div>
                )}
                <div class={`side right ${res && res.scoreB > res.scoreA ? "recap-winner" : ""}`}>{teamName(teams, b)}</div>
              </div>
            );
          })}
        </details>
        );
      })}
    </div>
  </section>

  <!-- STANDINGS -->
  <section class="page" id="page-standings">
    <div class="section-eyebrow">League Table</div>
    <div class="section-title">Standings</div>
    <table class="standings">
      <thead>
        <tr><th>#</th><th>Team</th><th>P</th><th>W</th><th>D</th><th>L</th><th>PF</th><th>PA</th><th>Diff</th><th>Pts</th></tr>
      </thead>
      <tbody>
        {standings.map((r: any, i: number) => (
          <tr>
            <td>{i + 1}</td>
            <td>{r.name}</td>
            <td>{r.P}</td><td>{r.W}</td><td>{r.D}</td><td>{r.L}</td>
            <td>{r.PF}</td><td>{r.PA}</td><td>{r.PF - r.PA}</td>
            <td class="pts-col">{r.Pts}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- LIVE -->
  <section class="page" id="page-live">
    <div class="section-eyebrow">This Gameweek</div>
    <div class="section-title">Live Scores {meta.currentGameweek ? `— GW${meta.currentGameweek}` : ""}</div>
    <div class="live-banner" id="liveScoresBanner">
      {finalMatchesForCurrentGw.length ? (
        <>&#10003; Gameweek {meta.currentGameweek} final. This result is locked in and won't change.</>
      ) : (
        <><span class="live-dot"></span> Real FPL live gameweek scores, checked for updates every minute. Click a team to see the player breakdown.</>
      )}
    </div>
    <div>
      {(currentGwFixture?.matches || []).map((m: [number, number]) => {
        const finalMatch = finalMatchesForCurrentGw.find((x: any) => x.a === m[0] && x.b === m[1]);
        const lsMatch = liveScores?.matches?.find((x: any) => x.a === m[0] && x.b === m[1]);
        const initialA = finalMatch?.scoreA ?? lsMatch?.scoreA ?? 0;
        const initialB = finalMatch?.scoreB ?? lsMatch?.scoreB ?? 0;
        const breakdownA = finalMatch?.breakdownA;
        const breakdownB = finalMatch?.breakdownB;
        // Only shown for a match still in progress (or pre-kickoff) — once it's final,
        // there's nothing left to be uncertain about, so remaining/win-prob just disappears.
        const showMatchMeta = !finalMatch && lsMatch && lsMatch.remainingA != null;
        return (
        <div class="score-card-wrap">
          <div class="score-card">
            <div class="team-name">{teamName(teams, m[0])}</div>
            <div class="score" id={`live-score-${m[0]}-${m[1]}`}>{initialA} &ndash; {initialB}</div>
            <div class="team-name right">{teamName(teams, m[1])}</div>
          </div>
          {showMatchMeta && (
            <div class="match-meta" id={`match-meta-${m[0]}-${m[1]}`}>
              <span class="match-meta-side">
                <span class="match-meta-line">{lsMatch.remainingA} yet to play</span>
                <span class="match-meta-line">{lsMatch.winProbA}% to win</span>
              </span>
              <span class="match-meta-side right">
                <span class="match-meta-line">{lsMatch.remainingB} yet to play</span>
                <span class="match-meta-line">{lsMatch.winProbB}% to win</span>
              </span>
            </div>
          )}
          {showMatchMeta && (
            <div class="win-prob-bar" id={`win-prob-bar-${m[0]}-${m[1]}`} title="Estimated win probability — a heuristic, not an official stat">
              <div class="win-prob-fill-a" style={`width:${lsMatch.winProbA}%`}></div>
              <div class="win-prob-fill-b" style={`width:${lsMatch.winProbB}%`}></div>
            </div>
          )}
          <div class="score-breakdown">
            <details>
              <summary>Points overview <span class="chevron">+</span></summary>
              <ul class="breakdown-list" id={`breakdown-${m[0]}`}>
                {breakdownA
                  ? breakdownA.map((p: any) => (
                      <li>
                        <span class="player-cell" data-player-id={p.playerId} tabindex="0">
                          <img class="player-photo" src={playerPhotoUrl(codeByPlayerId.get(p.playerId))} loading="lazy" alt="" onerror={photoOnError} />
                          {p.name}
                        </span>
                        <span class="pts">{p.points}</span>
                      </li>
                    ))
                  : <li class="empty-note">Squad not drafted yet.</li>}
              </ul>
            </details>
            <details>
              <summary>Points overview <span class="chevron">+</span></summary>
              <ul class="breakdown-list" id={`breakdown-${m[1]}`}>
                {breakdownB
                  ? breakdownB.map((p: any) => (
                      <li>
                        <span class="player-cell" data-player-id={p.playerId} tabindex="0">
                          <img class="player-photo" src={playerPhotoUrl(codeByPlayerId.get(p.playerId))} loading="lazy" alt="" onerror={photoOnError} />
                          {p.name}
                        </span>
                        <span class="pts">{p.points}</span>
                      </li>
                    ))
                  : <li class="empty-note">Squad not drafted yet.</li>}
              </ul>
            </details>
          </div>
        </div>
        );
      })}
    </div>
  </section>

  <!-- PLAYERS -->
  <section class="page" id="page-players">
    <div class="section-eyebrow">Free Agents</div>
    <div class="section-title">Unpicked Players (<span id="unpickedCount">{unpickedCount}</span>)</div>
    <p class="empty-note">Sorted by FPL points this season. Updates live the instant a player's drafted during the auction.</p>
    <div class="search-row">
      <input type="text" id="playerSearch" placeholder="Search a player, club or position...">
      <select id="playerSortSelect" class="sort-select">
        {PLAYER_SORT_OPTIONS.map((opt) => <option value={opt.value}>{opt.label}</option>)}
      </select>
    </div>
    <div class="table-scroll">
    <table class="players">
      <thead>
        <tr><th>Player</th><th>Pos</th><th>Club</th><th>Sel %</th><th id="statColHeader">Total points</th><th>Next 5</th></tr>
      </thead>
      <tbody id="playersBody">
        {players
          .filter((p: any) => p.draftedBy === null)
          .sort((a: any, b: any) =>
            b.pts - a.pts ||
            (b.selectedByPercent ?? 0) - (a.selectedByPercent ?? 0) ||
            a.name.localeCompare(b.name),
          )
          .map((p: any) => {
            const stats: Record<string, any> = {};
            for (const opt of PLAYER_SORT_OPTIONS) stats[opt.value] = p[opt.value] ?? null;
            return (
            <tr
              data-search={`${p.name} ${p.club} ${p.pos}`.toLowerCase()}
              data-player-id={p.id ?? ""}
              data-drafted="0"
              data-stats={JSON.stringify(stats)}
            >
              <td><span class="player-cell" data-player-id={p.id} tabindex="0"><img class="player-photo" src={playerPhotoUrl(p.code)} loading="lazy" alt="" onerror={photoOnError} />{p.name}</span></td>
              <td><span class="pos-badge">{p.pos}</span></td>
              <td>{p.club}</td>
              <td class="mono">{(p.selectedByPercent ?? 0).toFixed(1)}%</td>
              <td class="mono stat-cell">{p.pts}</td>
              <td>
                <div class="fdr-row">
                  {(clubFixtures[p.club] || []).map((f: any) => (
                    <span class={`fdr-box ${fdrClass(f.difficulty)}`}>{f.opponent} {f.isHome ? "(H)" : "(A)"}</span>
                  ))}
                </div>
              </td>
            </tr>
            );
          })}
      </tbody>
    </table>
    </div>
    <p class="empty-note" id="noPlayersNote" style="display:none;">No players match that search.</p>
  </section>

  <!-- PL MATCHES -->
  <section class="page" id="page-pl-matches">
    <div class="section-eyebrow">Real Premier League</div>
    <div class="section-title">Upcoming PL Matches</div>
    <p class="empty-note">Every Premier League fixture FPL still has coming up. A gameweek drops off this list automatically once it's finished.</p>
    <div>
      {[...plMatchesByGw.keys()].sort((a, b) => a - b).map((gw) => (
        <details class="gw-block">
          <summary>
            <span>Gameweek {gw}</span>
            <span class="chevron">+</span>
          </summary>
          {plMatchesByGw.get(gw)!.map((m: any) => (
            <div class="pl-match-row">
              <div class="pl-date">{formatKickoff(m.kickoff)}</div>
              <div class="pl-teams">{m.teamH} <span class="vs">vs</span> {m.teamA}</div>
            </div>
          ))}
        </details>
      ))}
      {plMatchesByGw.size === 0 && (
        <p class="empty-note">No upcoming fixtures — FPL hasn't published any yet, or the season's done.</p>
      )}
    </div>
  </section>

  <!-- FAQ -->
  <section class="page" id="page-faq">
    <div class="section-eyebrow">Read This First</div>
    <div class="section-title">FAQ &mdash; How This League Works</div>
    <div>
      {FAQ.map((cat) => (
        <>
          <div class="faq-cat">{cat.cat}</div>
          {cat.items.map(([q, a]) => (
            <details class="faq-item">
              <summary>{q}<span class="plus">+</span></summary>
              <p>{a}</p>
            </details>
          ))}
        </>
      ))}
    </div>
  </section>

</main>


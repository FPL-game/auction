<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('nav.tabs button');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.page').forEach((p) => p.classList.remove('active'));
      document.getElementById('page-' + btn.dataset.page)?.classList.add('active');
    });
  });

  const searchInput = document.getElementById('playerSearch') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#playersBody tr'));
  const noPlayersNote = document.getElementById('noPlayersNote');

  function updateRowVisibility() {
    const f = (searchInput?.value || '').trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const matchesSearch = !f || (row.dataset.search || '').includes(f);
      const isUnpicked = row.dataset.drafted !== '1';
      const show = matchesSearch && isUnpicked;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (noPlayersNote) noPlayersNote.style.display = visible ? 'none' : '';
  }
  (window as any).updateRowVisibility = updateRowVisibility;
  searchInput?.addEventListener('input', updateRowVisibility);
</script>


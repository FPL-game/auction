---
import auctionLeagueData from "../data/auctionLeague.json";
import { computeStandings, teamName } from "../lib/auctionLeagueUtils.mjs";

const state = auctionLeagueData as any;
const { teams, fixtures, results, players, meta } = state;
// Generated fresh every sync run (scripts/update-fpl-data.mjs) from real current
// data — unpicked players, budgets, rosters. Empty until the first sync after this
// feature ships.
const rumours = state.rumours || [];

const standings = computeStandings(teams, results);

const tickerItems = teams.map(
  (t: any) => `${t.name.toUpperCase()} &middot; ${t.remainingBudget + t.waiverBudget}M LEFT`,
);
const tickerText = tickerItems.join(" &nbsp; / &nbsp; ");

const unpickedCount = players.filter((p: any) => p.draftedBy === null).length;

// ---- Match Day Recap: most recently completed gameweek, from real results ----
const playedGws = Object.keys(results).map((k: string) => Number(k.split("-")[0]));
const latestGw = playedGws.length ? Math.max(...playedGws) : null;
const latestGwFixture = latestGw ? fixtures.find((f: any) => f.gw === latestGw) : null;
const latestRecaps = (latestGwFixture?.matches || [])
  .map(([a, b]: [number, number]) => {
    const res = results[`${latestGw}-${a}-${b}`];
    if (!res) return null;
    const winner = res.scoreA > res.scoreB ? a : res.scoreB > res.scoreA ? b : null;
    const margin = Math.abs(res.scoreA - res.scoreB);
    return { a, b, scoreA: res.scoreA, scoreB: res.scoreB, winner, margin };
  })
  .filter((r: any) => r !== null);

function recapFlavor(r: any) {
  if (r.winner === null) return "Honours even — both sides walk away with a point.";
  const winnerName = teamName(teams, r.winner);
  const loserName = teamName(teams, r.winner === r.a ? r.b : r.a);
  if (r.margin >= 40) return `${winnerName} put on an absolute clinic against ${loserName}. Not much to say here.`;
  if (r.margin >= 20) return `${winnerName} take a comfortable win over ${loserName}.`;
  if (r.margin <= 5) return `${winnerName} edge out ${loserName} in a nail-biter. Margins don't get much finer.`;
  return `${winnerName} get the better of ${loserName} in a solid week.`;
}

// ---- Injury Wire source data (players with real FPL news, for owned-player cross-reference client-side) ----
const playersWithNews = players
  .filter((p: any) => p.news && p.news.trim().length > 0)
  .map((p: any) => ({ id: p.id, name: p.name, pos: p.pos, club: p.club, news: p.news }));

// Until the first Gameweek result exists, Squad Moves/Injury Wire/Match Recap are thin —
// lead with the Social Media feed instead. Reverts automatically once real results land.
const preSeasonMode = Object.keys(results).length === 0;

const FAQ = [
  { cat: "The Basics", items: [
    ["How does the draft work?", "Everyone bids live on players, one at a time, until all 6 squads are full. It's a real auction — whoever bids highest gets the player, no snake-draft turns."],
    ["What's the budget?", "Everyone starts with 100m to build an 11-player squad. Spend it however you like — there's no rule on how much to spend per position."],
    ["Do I need a specific formation?", "No. The only rule is 1 goalkeeper. The other 10 spots can be any mix of defenders, midfielders and forwards you want."],
    ["Can two teams own the same player?", "No. Once a player is bought, they're off the market for everyone else all season."],
    ["Is there a bench?", "No bench. All 11 players you own are your starting XI every Gameweek. If one of them doesn't play, you just take the zero."],
  ]},
  { cat: "Scoring & The Table", items: [
    ["How are points calculated?", "Standard FPL points — whatever each player scores in real Fantasy Premier League that Gameweek is what counts for your team."],
    ["Do captains or chips apply?", "No captaincy and no chips (no Wildcard, Bench Boost, Triple Captain, Free Hit). Just your 11 players' raw points added up."],
    ["How do fixtures work?", "One match per Gameweek slot, just like real Premier League weekends — 3 games happen simultaneously each GW, and every team plays every other team once every 5 Gameweeks, repeating all season."],
    ["How do I win a match?", "Whoever's 11 players score more total points that Gameweek wins. 3 points for a win, 1 each for a draw, 0 for a loss."],
    ["How are ties on the table broken?", "First by total points scored across the season, then by points differential (points for minus points against)."],
  ]},
  { cat: "Transfers & Waivers", items: [
    ["Can I change my squad during the season?", "Yes. You can release a player any time (no fee) and replace them through a mini-bidding process."],
    ["How does replacing a player work?", "You announce who you're releasing. That opens a 24-hour window where anyone — including you — can bid to bring in the replacement."],
    ["What do I bid with?", "A separate waiver budget: 20m per team, plus whatever you didn't spend from your original 100m draft budget."],
    ["When can transfers happen?", "Any time, except during a locked window — from 6 hours before the first game of a Gameweek until that Gameweek finishes."],
    ["Can a transfer be blocked?", "Yes. If 2 or more of the 6 managers vote that a transfer is unfair, it's overturned."],
  ]},
  { cat: "Admin", items: [
    ["Who runs the league?", "Claude keeps the live leaderboard on this site and syncs real FPL scores automatically every 2 hours during Gameweeks, so anything can be corrected quickly if there's a mistake."],
    ["Where do I check live scores?", "The Live Scores tab — it reflects the current Gameweek's matches based on real FPL data as it comes in."],
  ]},
];
---

<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Auction League</title>
<meta name="description" content="A 6-manager FPL auction draft mini-league — rosters, fixtures, standings and live scores." />
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@400;500;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --pitch: #0A1712;
    --pitch-2: #0F1F18;
    --card: #12271D;
    --card-2: #163024;
    --line: #24402F;
    --turf: #37C871;
    --turf-dim: #1F6B3E;
    --amber: #FFB627;
    --white: #F3F6F1;
    --grey: #8AA095;
    --red: #E8543F;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background: radial-gradient(ellipse at top, #12281D 0%, var(--pitch) 55%);
    color: var(--white);
    font-family: 'Work Sans', sans-serif;
    min-height: 100vh;
    padding-bottom: 60px;
  }
  .mono{ font-family:'JetBrains Mono', monospace; }
  .display{ font-family:'Anton', sans-serif; text-transform:uppercase; letter-spacing:0.02em; }

  .ticker-wrap{
    background: var(--turf);
    color: var(--pitch);
    overflow:hidden;
    white-space:nowrap;
    border-bottom: 2px solid var(--pitch);
  }
  .ticker{
    display:inline-block;
    padding: 6px 0;
    animation: scroll-left 28s linear infinite;
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  @keyframes scroll-left{
    0%{ transform: translateX(0%); }
    100%{ transform: translateX(-50%); }
  }

  header.top{
    padding: 28px 24px 0;
    max-width: 1100px;
    margin: 0 auto;
  }
  .brand{
    display:flex;
    align-items:baseline;
    gap: 12px;
    flex-wrap:wrap;
  }
  .brand h1{
    font-size: clamp(32px, 6vw, 56px);
    color: var(--white);
    line-height: 0.95;
  }
  .brand h1 em{ font-style:normal; color: var(--turf); }
  .brand .sub{ color: var(--grey); font-size: 13px; letter-spacing:0.05em; text-transform:uppercase; font-family:'JetBrains Mono', monospace; }

  nav.tabs{
    max-width: 1100px;
    margin: 22px auto 0;
    padding: 0 24px;
    display:flex;
    gap: 4px;
    flex-wrap: wrap;
    border-bottom: 2px solid var(--line);
  }
  nav.tabs button{
    background: transparent;
    border: none;
    color: var(--grey);
    font-family:'Anton', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 14px;
    padding: 12px 16px;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  nav.tabs button:hover{ color: var(--white); }
  nav.tabs button.active{ color: var(--turf); border-bottom-color: var(--turf); }

  main{
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px 0;
  }
  .page{ display:none; animation: fade-in 0.25s ease; }
  .page.active{ display:block; }
  @keyframes fade-in{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);} }

  .section-eyebrow{
    color: var(--turf);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .section-title{
    font-size: clamp(22px, 4vw, 32px);
    margin-bottom: 20px;
  }

  .team-grid{
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .team-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 20px;
    position: relative;
    overflow: hidden;
  }
  .team-card::before{
    content: attr(data-num);
    position:absolute;
    right: 12px; top: -6px;
    font-family:'Anton', sans-serif;
    font-size: 64px;
    color: var(--line);
    opacity:0.5;
    line-height:1;
  }
  .team-card h3{
    font-family:'Anton', sans-serif;
    text-transform:uppercase;
    font-size: 22px;
    letter-spacing:0.02em;
    color: var(--white);
    position:relative;
  }
  .team-card .tag{
    color:var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    margin-bottom: 14px;
    display:block;
  }
  .budget-row{
    display:flex;
    gap: 10px;
    margin-bottom: 14px;
  }
  .budget-pill{
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 8px 12px;
    flex:1;
  }
  .budget-pill .num{
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size: 18px;
    color: var(--turf);
  }
  .budget-pill .lbl{
    font-size: 10px;
    color: var(--grey);
    text-transform:uppercase;
    letter-spacing:0.08em;
  }
  .roster-list{
    list-style:none;
    border-top: 1px dashed var(--line);
    padding-top: 10px;
  }
  .roster-list li{
    display:flex;
    justify-content:space-between;
    padding: 5px 0;
    font-size: 13px;
    color: var(--white);
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .roster-list li .pos{
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size:11px;
    margin-right: 8px;
  }
  .empty-note{
    color: var(--grey);
    font-size: 13px;
    font-style: italic;
    padding: 10px 0;
  }

  .news-wire-stack{
    display: flex;
    flex-direction: column;
  }
  .news-block{
    margin-bottom: 32px;
  }
  .news-block-head{
    display:flex;
    align-items:center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .news-block-title{
    font-family:'Anton', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 18px;
    color: var(--white);
  }
  .news-block-tag{
    font-family:'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--grey);
    background: var(--card-2);
    border: 1px solid var(--line);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .news-block-tag.live-tag{ color: var(--turf); border-color: var(--turf); }
  .recap-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px 18px;
    margin-bottom: 10px;
  }
  .recap-teams{
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size: 15px;
    color: var(--white);
    margin-bottom: 6px;
  }
  .recap-winner{ color: var(--turf); }
  .recap-vs{ color: var(--grey); margin: 0 8px; }
  .recap-flavor{ color: var(--grey); font-size: 13px; }

  .rumours-section{
    margin-bottom: 32px;
  }
  .rumours-head{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    margin-bottom: 14px;
  }
  .rumours-refresh{
    background: transparent;
    border: 1px solid var(--line);
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
  }
  .rumours-refresh:hover{ color: var(--white); border-color: var(--turf); }
  .tweet-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 10px;
    display:flex;
    gap: 12px;
  }
  .tweet-avatar{
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Anton', sans-serif;
    font-size: 15px;
    color: var(--pitch);
    flex-shrink: 0;
  }
  .tweet-body{ flex: 1; min-width: 0; }
  .tweet-meta{
    display:flex;
    align-items:baseline;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 3px;
  }
  .tweet-name{ font-weight:700; font-size: 13px; color: var(--white); }
  .tweet-check{ color: var(--turf); font-size: 12px; }
  .tweet-handle{ color: var(--grey); font-size: 12px; font-family:'JetBrains Mono', monospace; }
  .tweet-time{ color: var(--grey); font-size: 11px; font-family:'JetBrains Mono', monospace; margin-left: auto; }
  .tweet-text{ font-size: 13px; line-height: 1.5; color: var(--white); }
  .rumours-disclaimer{
    color: var(--grey);
    font-size: 11px;
    font-style: italic;
    margin-top: 10px;
  }

  .gw-block{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 10px;
  }
  .gw-block summary{
    cursor:pointer;
    font-family:'Anton', sans-serif;
    text-transform:uppercase;
    font-size: 16px;
    color: var(--turf);
    letter-spacing:0.03em;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .gw-block summary::-webkit-details-marker{ display:none; }
  .gw-block summary .chevron{ color: var(--grey); font-family:'JetBrains Mono',monospace; }
  .match-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 10px 4px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .match-row .side{ flex:1; }
  .match-row .side.right{ text-align:right; }
  .match-row .vs{
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 0 14px;
  }

  table.standings{
    width:100%;
    border-collapse: collapse;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow:hidden;
  }
  table.standings th{
    background: var(--card-2);
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing: 0.08em;
    padding: 12px 10px;
    text-align:left;
  }
  table.standings td{
    padding: 12px 10px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  table.standings tbody tr:nth-child(1) td:first-child{ color: var(--turf); font-weight:700; }
  .pts-col{ color: var(--amber); font-family:'JetBrains Mono', monospace; font-weight:700; }

  .live-banner{
    display:flex;
    align-items:center;
    gap:10px;
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 18px;
    font-family:'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--grey);
  }
  .live-dot{
    width:8px; height:8px; border-radius:50%;
    background: var(--red);
    animation: pulse 1.4s infinite;
    flex-shrink:0;
  }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:0.3;} }
  .score-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 14px;
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .score-card .team-name{
    font-family:'Anton', sans-serif;
    text-transform:uppercase;
    font-size: 18px;
    flex:1;
  }
  .score-card .team-name.right{ text-align:right; }
  .score-card .score{
    font-family:'JetBrains Mono', monospace;
    font-size: 32px;
    font-weight:700;
    color: var(--turf);
    padding: 0 24px;
    min-width: 110px;
    text-align:center;
  }

  .score-card-wrap{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    margin-bottom: 14px;
    overflow: hidden;
  }
  .score-card-wrap .score-card{
    margin-bottom: 0;
    border-radius: 0;
    border: none;
  }
  .score-breakdown{
    display:flex;
    border-top: 1px solid var(--line);
  }
  .score-breakdown details{
    flex: 1;
    padding: 10px 16px;
  }
  .score-breakdown details:first-child{
    border-right: 1px solid var(--line);
  }
  .score-breakdown summary{
    cursor:pointer;
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color: var(--grey);
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .score-breakdown summary::-webkit-details-marker{ display:none; }
  .score-breakdown summary .chevron{ font-family:'JetBrains Mono', monospace; }
  .breakdown-list{
    list-style:none;
    padding-top: 8px;
  }
  .breakdown-list li{
    display:flex;
    justify-content:space-between;
    padding: 4px 0;
    font-size: 13px;
  }
  .breakdown-list .pts{
    font-family:'JetBrains Mono', monospace;
    color: var(--turf);
  }

  .search-row{ margin-bottom: 16px; }
  .search-row input{
    width:100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 14px;
    color: var(--white);
    font-family:'Work Sans', sans-serif;
    font-size: 14px;
  }
  table.players{
    width:100%;
    border-collapse: collapse;
  }
  table.players th{
    text-align:left;
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing:0.08em;
    padding: 8px 10px;
    border-bottom: 2px solid var(--line);
  }
  table.players td{
    padding: 9px 10px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  table.players tr:hover td{ background: var(--card-2); }
  .pos-badge{
    font-family:'JetBrains Mono', monospace;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--card-2);
    color: var(--turf);
    border: 1px solid var(--line);
  }
  .drafted-badge{
    font-family:'JetBrains Mono', monospace;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255,182,39,0.12);
    color: var(--amber);
    border: 1px solid var(--line);
  }

  .faq-item{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    margin-bottom: 10px;
    overflow:hidden;
  }
  .faq-item summary{
    cursor:pointer;
    padding: 16px 18px;
    font-weight:600;
    font-size: 15px;
    color: var(--white);
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .faq-item summary::-webkit-details-marker{ display:none; }
  .faq-item summary .plus{
    font-family:'JetBrains Mono', monospace;
    color: var(--turf);
    font-size: 18px;
  }
  .faq-item p{
    padding: 0 18px 18px;
    color: var(--grey);
    font-size: 14px;
    line-height: 1.6;
  }
  .faq-cat{
    color: var(--amber);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing: 0.12em;
    margin: 26px 0 10px;
  }
  .faq-cat:first-child{ margin-top: 0; }

  footer{
    max-width:1100px;
    margin: 40px auto 0;
    padding: 20px 24px;
    color: var(--grey);
    font-size: 12px;
    font-family:'JetBrains Mono', monospace;
    border-top: 1px solid var(--line);
  }

  @media (max-width:600px){
    nav.tabs{ overflow-x:auto; flex-wrap:nowrap; }
    .score-card{ flex-direction:column; gap:10px; }
    .score-card .score{ padding:0; }
  }
</style>
</head>
<body>

<div class="ticker-wrap">
  <div class="ticker" id="tickerText" set:html={tickerText + " &nbsp; / &nbsp; " + tickerText}></div>
</div>

<header class="top">
  <div class="brand">
    <h1>THE <em>AUCTION</em> LEAGUE</h1>
  </div>
  <div class="sub">6 managers &middot; 100M budget &middot; 38 gameweeks &middot; no mercy</div>
</header>

<nav class="tabs" id="tabs">
  <button data-page="home" class="active">Home</button>
  <button data-page="squads">Squads</button>
  <button data-page="fixtures">Fixtures</button>
  <button data-page="standings">Standings</button>
  <button data-page="live">Live Scores</button>
  <button data-page="players">Players</button>
  <button data-page="faq">FAQ</button>

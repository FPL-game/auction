<script>
  const rumours = JSON.parse(document.getElementById('rumoursSeed').textContent);
  const TIMES = ['now', '2m', '5m', '11m', '23m', '38m', '1h', '2h', '4h', '6h', 'yesterday'];

  // A random glyph per post beats every avatar being the same two letters — these are
  // fake accounts anyway, so there's no "real" photo to be faithful to.
  const AVATAR_ICONS = ['⚽','🔥','🎯','🏆','💬','📣','🐐','👑','🚀','💥','🎙️','🌟','🔍','🧠','🗣️','🚨','🥅','🎉','🍿','🧢','👀','😤','🙌','📈'];
  function randomAvatarIcon() {
    return AVATAR_ICONS[Math.floor(Math.random() * AVATAR_ICONS.length)];
  }

  function shuffled(arr) {
    const copy = [...arr];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  // Dispensed without replacement from a shuffled copy of the full pool (baked at build
  // time, up to 150 posts) so hitting Refresh repeatedly always surfaces posts you haven't
  // seen yet this visit, instead of re-shuffling the same handful back at you. Only once
  // the whole pool has been shown does it reshuffle and start a fresh lap.
  let rumoursQueue = [];
  function renderRumours() {
    const feed = document.getElementById('rumoursFeed');
    if (!feed) return;
    if (!rumours.length) {
      feed.innerHTML = '<p class="empty-note">Nothing doing right now — check back after the next sync.</p>';
      return;
    }
    if (rumoursQueue.length < 9) rumoursQueue = shuffled(rumours);
    const picks = rumoursQueue.splice(0, 9);
    feed.innerHTML = picks.map((r) => `
      <div class="tweet-card">
        <div class="tweet-avatar" style="background:${r.color}">${randomAvatarIcon()}</div>
        <div class="tweet-body">
          <div class="tweet-meta">
            <span class="tweet-name">${r.name}</span>
            <span class="tweet-check">&#10003;</span>
            <span class="tweet-handle">${r.handle}</span>
            <span class="tweet-time">${TIMES[Math.floor(Math.random() * TIMES.length)]}</span>
          </div>
          <div class="tweet-text">${r.text}</div>
        </div>
      </div>
    `).join('');
  }

  renderRumours();
  document.getElementById('rumoursRefresh')?.addEventListener('click', renderRumours);

  // ---- Live reactions: as soon as the admin logs a real move, the crowd starts talking ----
  const LIVE_FAN_PERSONAS = [
    { handle: '@BenchWarmerBrian', name: 'Brian', color: '#8892A6' },
    { handle: '@ArmchairGaffer', name: 'The Armchair Gaffer', color: '#C9A227' },
    { handle: '@TripleCaptainTom', name: 'Tom', color: '#4A90D9' },
    { handle: '@FPL_Degenerate', name: 'FPL Degenerate', color: '#E15554' },
    { handle: '@BigManBants', name: 'Big Man Bants', color: '#8892A6' },
    { handle: '@ShoutyFromTheSofa', name: 'Shouty From The Sofa', color: '#E15554' },
  ];

  function liveMoveText(d) {
    if (d.type === 'trade') {
      const aNames = (d.playersAToB || []).map((p) => p.name).join(' and ') || 'nothing';
      const bNames = (d.playersBToA || []).map((p) => p.name).join(' and ') || 'nothing';
      const lines = [
        `wait ${d.teamAName} actually traded ${aNames} to ${d.teamBName} for ${bNames}?? need a minute to process this 👀`,
        `${d.teamAName} and ${d.teamBName} just made a trade and the group chat has not recovered`,
        `trade alert: ${aNames} to ${d.teamBName}, ${bNames} to ${d.teamAName}. somebody's going to win this and somebody's going to lose this`,
      ];
      return lines[Math.floor(Math.random() * lines.length)];
    }
    if (d.type === 'remove') {
      return `${d.teamName} just cut ${d.playerName} loose. brutal, but somebody had to do it`;
    }
    const lines = [
      `${d.teamName} just added ${d.playerName} for ${d.price}m and I need everyone to just sit with that for a second 👀`,
      `${d.teamName} picking up ${d.playerName} live right now. genius or cry for help, genuinely could be both`,
      `breaking: ${d.playerName} to ${d.teamName} for ${d.price}m. bold. unhinged. slightly evil. I respect it 🔥`,
    ];
    return lines[Math.floor(Math.random() * lines.length)];
  }

  function reactToMove(d) {
    const feed = document.getElementById('rumoursFeed');
    if (!feed) return;
    const emptyNote = feed.querySelector('.empty-note');
    if (emptyNote) emptyNote.remove();
    const persona = LIVE_FAN_PERSONAS[Math.floor(Math.random() * LIVE_FAN_PERSONAS.length)];
    const card = document.createElement('div');
    card.className = 'tweet-card';
    card.innerHTML = `
      <div class="tweet-avatar" style="background:${persona.color}">${randomAvatarIcon()}</div>
      <div class="tweet-body">
        <div class="tweet-meta">
          <span class="tweet-name">${persona.name}</span>
          <span class="tweet-check">&#10003;</span>
          <span class="tweet-handle">${persona.handle}</span>
          <span class="tweet-time">now</span>
        </div>
        <div class="tweet-text">${liveMoveText(d)}</div>
      </div>
    `;
    feed.prepend(card);
    while (feed.children.length > 12) feed.removeChild(feed.lastChild);
  }
  (window as any).reactToMove = reactToMove;
</script>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-app.js";
  import { getFirestore, doc, onSnapshot, collection, query, orderBy, limit } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore.js";

  // Public client config — safe to expose; write access is restricted by
  // Firestore security rules (auth required), not by hiding this object.
  const firebaseConfig = {
    apiKey: "AIzaSyApmHdW9Jj__ejTY6jKu2j-TG_KyTQYVN4",
    authDomain: "fpl-auction.firebaseapp.com",
    projectId: "fpl-auction",
    storageBucket: "fpl-auction.firebasestorage.app",
    messagingSenderId: "113884648410",
    appId: "1:113884648410:web:ede97721bcf2c57aa3e6e3",
  };
  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  const seedTeams = JSON.parse(document.getElementById('teamsSeed').textContent);
  // eventPoints (season-long snapshot from FPL's bootstrap-static) is the fallback source —
  // used when no gameweek is currently live. liveScoresData/livePointsMap (real per-gameweek
  // live points, from FPL's live event feed) take priority whenever they're present, and get
  // refreshed periodically below without needing a full page reload.
  const playerPointsSeedData = JSON.parse(document.getElementById('playerPointsSeed').textContent);
  const playerPoints = new Map(playerPointsSeedData.map((p) => [String(p.id), p.eventPoints]));
  const playerCodes = new Map(playerPointsSeedData.map((p) => [String(p.id), p.code]));
  const MISSING_PHOTO_URL = 'https://resources.premierleague.com/premierleague/photos/players/110x140/Photo-Missing.png';
  function playerPhotoUrl(code) {
    return code
      ? `https://resources.premierleague.com/premierleague/photos/players/110x140/p${code}.png`
      : MISSING_PHOTO_URL;
  }
  const PHOTO_ONERROR = `this.onerror=null;this.src='${MISSING_PHOTO_URL}';`;
  const AVATAR_ICONS = ['⚽','🔥','🎯','🏆','💬','📣','🐐','👑','🚀','💥','🎙️','🌟','🔍','🧠','🗣️','🚨','🥅','🎉','🍿','🧢','👀','😤','🙌','📈'];
  function randomAvatarIcon() {
    return AVATAR_ICONS[Math.floor(Math.random() * AVATAR_ICONS.length)];
  }
  const playersNews = new Map(
    JSON.parse(document.getElementById('playersNewsSeed').textContent).map((p) => [String(p.id), p]),
  );
  let liveScoresSeed = JSON.parse(document.getElementById('liveScoresSeed').textContent);
  let liveScoresData = liveScoresSeed.liveScores;
  let livePointsMap = new Map(Object.entries(liveScoresSeed.livePlayerPoints || {}));
  // Keyed by "a-b" — a frozen result for this match, once one exists, always wins over
  // any live/roster-derived number (see the comment on finalMatchesForCurrentGw above).
  let finalMatchesMap = new Map((liveScoresSeed.finalMatches || []).map((m) => [`${m.a}-${m.b}`, m]));
  const DEFAULTS = { remainingBudget: 100, waiverBudget: 20, roster: [] };
  const liveTeams = {}; // teamId -> {name, remainingBudget, waiverBudget, roster}
  let anyLive = false;

  function pointsFor(playerId) {
    const key = String(playerId);
    return livePointsMap.has(key) ? livePointsMap.get(key) : (playerPoints.get(key) ?? 0);
  }

  function renderInjuryWire() {
    const feed = document.getElementById('injuryWireFeed');
    if (!feed) return;
    const items = [];
    for (const t of seedTeams) {
      const live = liveTeams[t.id] || DEFAULTS;
      for (const p of live.roster) {
        const news = playersNews.get(String(p.playerId));
        if (news) items.push({ team: t.name, ...news });
      }
    }
    feed.innerHTML = items.length
      ? items.slice(0, 5).map((n) => `
          <div class="tweet-card">
            <div class="tweet-avatar" style="background:#E15554">${randomAvatarIcon()}</div>
            <div class="tweet-body">
              <div class="tweet-meta"><span class="tweet-name">${n.name}</span><span class="tweet-handle">${n.club} &middot; owned by ${n.team}</span></div>
              <div class="tweet-text">${n.news}</div>
            </div>
          </div>
        `).join('')
      : '<p class="empty-note">No injury concerns for owned players right now.</p>';
  }

  function timeAgo(date) {
    const secs = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
    if (secs < 60) return 'just now';
    if (secs < 3600) return `${Math.floor(secs / 60)}m ago`;
    if (secs < 86400) return `${Math.floor(secs / 3600)}h ago`;
    return `${Math.floor(secs / 86400)}d ago`;
  }

  function renderSquadMoves(docs) {
    const feed = document.getElementById('squadMovesFeed');
    if (!feed) return;
    if (!docs.length) {
      feed.innerHTML = '<p class="empty-note">No moves logged yet — they\'ll appear here the moment the admin makes one.</p>';
      return;
    }
    feed.innerHTML = docs.map((d) => {
      if (d.type === 'trade') {
        const aNames = (d.playersAToB || []).map((p) => p.name).join(', ') || 'nothing';
        const bNames = (d.playersBToA || []).map((p) => p.name).join(', ') || 'nothing';
        const budgetBits = [];
        if (d.budgetAToB) budgetBits.push(`${d.budgetAToB}m to ${d.teamBName}`);
        if (d.budgetBToA) budgetBits.push(`${d.budgetBToA}m to ${d.teamAName}`);
        const budgetNote = budgetBits.length ? ` Plus ${budgetBits.join(' and ')}.` : '';
        const when = d.ts ? timeAgo(d.ts.toDate()) : 'just now';
        return `
          <div class="tweet-card">
            <div class="tweet-avatar" style="background:#C9A227">${randomAvatarIcon()}</div>
            <div class="tweet-body">
              <div class="tweet-meta">
                <span class="tweet-name">Trade Confirmed</span>
                <span class="tweet-check">&#10003;</span>
                <span class="tweet-handle">Squad News</span>
                <span class="tweet-time">${when}</span>
              </div>
              <div class="tweet-text">${d.teamAName} send ${aNames} to ${d.teamBName} in exchange for ${bNames}.${budgetNote}</div>
            </div>
          </div>
        `;
      }
      const isRemove = d.type === 'remove';
      const verb = isRemove ? 'release' : 'sign';
      const color = isRemove ? '#E15554' : '#4A90D9';
      const when = d.ts ? timeAgo(d.ts.toDate()) : 'just now';
      return `
        <div class="tweet-card">
          <div class="tweet-avatar" style="background:${color}">${randomAvatarIcon()}</div>
          <div class="tweet-body">
            <div class="tweet-meta">
              <span class="tweet-name">${d.teamName}</span>
              <span class="tweet-check">&#10003;</span>
              <span class="tweet-handle">Squad News</span>
              <span class="tweet-time">${when}</span>
            </div>
            <div class="tweet-text">${d.teamName} ${verb} ${d.playerName}${isRemove ? '' : ` for ${d.price}m`}.</div>
          </div>
        </div>
      `;
    }).join('');
  }

  let draftLogInitialized = false;
  onSnapshot(query(collection(db, 'draftLog'), orderBy('ts', 'desc'), limit(3)), (snap) => {
    renderSquadMoves(snap.docs.map((d) => d.data()));
    if (!draftLogInitialized) {
      // Skip reacting to the batch of moves that already existed on page load —
      // only genuinely new ones (added after this point) should trigger a live post.
      draftLogInitialized = true;
      return;
    }
    snap.docChanges().forEach((change) => {
      if (change.type === 'added') (window as any).reactToMove?.(change.doc.data());
    });
  });

  // frozenBreakdown, when given, is this gameweek's locked-in per-player breakdown for
  // this team's side of the match — rendered as-is and never recomputed from the live
  // roster/points. Only falls back to the roster+pointsFor() live computation when no
  // frozen result exists yet for this match (the gameweek is still genuinely in progress).
  function renderLiveScoreFor(teamId, frozenBreakdown) {
    const breakdownEl = document.getElementById(`breakdown-${teamId}`);
    if (frozenBreakdown) {
      if (breakdownEl) {
        breakdownEl.innerHTML = frozenBreakdown.length
          ? frozenBreakdown.map((p) => `<li><span class="player-cell" data-player-id="${p.playerId}" tabindex="0"><img class="player-photo" src="${playerPhotoUrl(playerCodes.get(String(p.playerId)))}" loading="lazy" alt="" onerror="${PHOTO_ONERROR}">${p.name}</span><span class="pts">${p.points}</span></li>`).join('')
          : '<li class="empty-note">Squad not drafted yet.</li>';
      }
      return frozenBreakdown.reduce((sum, p) => sum + p.points, 0);
    }
    const live = liveTeams[teamId] || DEFAULTS;
    let total = 0;
    if (breakdownEl) {
      breakdownEl.innerHTML = live.roster.length
        ? live.roster.map((p) => {
            const pts = pointsFor(p.playerId);
            total += pts;
            return `<li><span class="player-cell" data-player-id="${p.playerId}" tabindex="0"><img class="player-photo" src="${playerPhotoUrl(playerCodes.get(String(p.playerId)))}" loading="lazy" alt="" onerror="${PHOTO_ONERROR}">${p.name}</span><span class="pts">${pts}</span></li>`;
          }).join('')
        : '<li class="empty-note">Squad not drafted yet.</li>';
    } else {
      total = live.roster.reduce((sum, p) => sum + pointsFor(p.playerId), 0);
    }
    return total;
  }

  function renderMatchMeta(a, b, serverMatch) {
    const metaEl = document.getElementById(`match-meta-${a}-${b}`);
    const barEl = document.getElementById(`win-prob-bar-${a}-${b}`);
    if (!metaEl || !barEl) return;
    if (!serverMatch || serverMatch.remainingA == null) {
      metaEl.remove();
      barEl.remove();
      return;
    }
    metaEl.innerHTML = `<span class="match-meta-side"><span class="match-meta-line">${serverMatch.remainingA} yet to play</span><span class="match-meta-line">${serverMatch.winProbA}% to win</span></span><span class="match-meta-side right"><span class="match-meta-line">${serverMatch.remainingB} yet to play</span><span class="match-meta-line">${serverMatch.winProbB}% to win</span></span>`;
    barEl.innerHTML = `<div class="win-prob-fill-a" style="width:${serverMatch.winProbA}%"></div><div class="win-prob-fill-b" style="width:${serverMatch.winProbB}%"></div>`;
  }

  function renderAllLiveScores() {
    document.querySelectorAll('[id^="live-score-"]').forEach((scoreEl) => {
      const [a, b] = scoreEl.id.replace('live-score-', '').split('-');
      const finalMatch = finalMatchesMap.get(`${a}-${b}`);
      if (finalMatch) {
        // Locked in — render straight from the frozen result, never from the current
        // (possibly since-transferred) roster or FPL's still-shifting live points.
        renderLiveScoreFor(a, finalMatch.breakdownA);
        renderLiveScoreFor(b, finalMatch.breakdownB);
        scoreEl.textContent = `${finalMatch.scoreA} – ${finalMatch.scoreB}`;
        renderMatchMeta(a, b, null);
        return;
      }
      // renderLiveScoreFor() also fills in the per-player breakdown as a side effect —
      // always call both sides even though the headline number below may come from
      // the server's own total instead, so the breakdown list stays in sync.
      const breakdownTotalA = renderLiveScoreFor(a);
      const breakdownTotalB = renderLiveScoreFor(b);
      const serverMatch = liveScoresData?.matches?.find((m) => String(m.a) === a && String(m.b) === b);
      const scoreA = serverMatch ? serverMatch.scoreA : breakdownTotalA;
      const scoreB = serverMatch ? serverMatch.scoreB : breakdownTotalB;
      scoreEl.textContent = `${scoreA} – ${scoreB}`;
      renderMatchMeta(a, b, serverMatch);
    });
  }

  // ---- Soft refresh: re-fetch this page's own HTML periodically and pull the freshest
  // live-score seed out of it, so the tab picks up a new sync+deploy without the user
  // needing to manually reload (still bounded by how often the sync workflow itself runs).
  async function refreshLiveScores() {
    try {
      const res = await fetch(location.pathname, { cache: 'no-store' });
      if (!res.ok) return;
      const html = await res.text();
      const freshDoc = new DOMParser().parseFromString(html, 'text/html');
      const freshSeedEl = freshDoc.getElementById('liveScoresSeed');
      if (!freshSeedEl) return;
      const fresh = JSON.parse(freshSeedEl.textContent);
      liveScoresData = fresh.liveScores;
      livePointsMap = new Map(Object.entries(fresh.livePlayerPoints || {}));
      finalMatchesMap = new Map((fresh.finalMatches || []).map((m) => [`${m.a}-${m.b}`, m]));
      const banner = document.getElementById('liveScoresBanner');
      if (banner) {
        banner.innerHTML = finalMatchesMap.size
          ? `&#10003; Gameweek ${fresh.currentGameweek} final. This result is locked in and won't change.`
          : `<span class="live-dot"></span> Real FPL live gameweek scores, checked for updates every minute. Click a team to see the player breakdown.`;
      }
      renderAllLiveScores();
    } catch (err) {
      // Silent — a failed background refresh just retries on the next tick.
    }
  }
  setInterval(refreshLiveScores, 60000);

  function renderTeamCard(teamId, data) {
    const budgetEl = document.getElementById(`budget-${teamId}`);
    const rosterEl = document.getElementById(`roster-${teamId}`);
    if (budgetEl) budgetEl.textContent = `${data.remainingBudget + data.waiverBudget}M`;
    if (rosterEl) {
      rosterEl.innerHTML = data.roster.length
        ? data.roster.map((p) => `<li><span class="player-cell" data-player-id="${p.playerId}" tabindex="0"><img class="player-photo" src="${playerPhotoUrl(playerCodes.get(String(p.playerId)))}" loading="lazy" alt="" onerror="${PHOTO_ONERROR}">${p.name}</span><span>${p.price}m</span></li>`).join('')
        : '<li class="empty-note">Squad not drafted yet.</li>';
    }
  }

  function renderTicker() {
    const items = seedTeams.map((t) => {
      const live = liveTeams[t.id] || DEFAULTS;
      return `${t.name.toUpperCase()} &middot; ${live.remainingBudget + live.waiverBudget}M LEFT`;
    });
    const text = items.join(' &nbsp; / &nbsp; ');
    const el = document.getElementById('tickerText');
    if (el) el.innerHTML = text + ' &nbsp; / &nbsp; ' + text;
  }

  function refreshDraftedStatus() {
    const draftedIds = new Set();
    for (const t of seedTeams) {
      const live = liveTeams[t.id] || DEFAULTS;
      for (const p of live.roster) {
        if (p.playerId != null) draftedIds.add(String(p.playerId));
      }
    }
    let unpicked = 0;
    document.querySelectorAll('#playersBody tr').forEach((row) => {
      const pid = row.dataset.playerId;
      const isDrafted = pid && draftedIds.has(pid);
      row.dataset.drafted = isDrafted ? '1' : '0';
      if (!isDrafted) unpicked++;
    });
    const countEl = document.getElementById('unpickedCount');
    if (countEl) countEl.textContent = String(unpicked);
    (window as any).updateRowVisibility?.();
  }

  seedTeams.forEach((t) => {
    onSnapshot(doc(db, 'teams', String(t.id)), (snap) => {
      const data = snap.exists() ? snap.data() : { ...DEFAULTS, name: t.name };
      liveTeams[t.id] = data;
      if (snap.exists() && data.roster && data.roster.length) anyLive = true;
      renderTeamCard(t.id, data);
      renderTicker();
      refreshDraftedStatus();
      renderAllLiveScores();
      renderInjuryWire();
      const banner = document.getElementById('draftLiveBanner');
      if (banner) banner.style.display = anyLive ? 'flex' : 'none';
    });
  });
</script>

<script>
  // Player detail pop-up: click any player name/photo anywhere on the site (Squads,
  // Live Scores breakdowns, Players tab — server-rendered or client re-rendered, since
  // this listens on document rather than binding per-element) to see their real FPL
  // stats for the season. Not a copy of FPL's own page (that's not something this site
  // can pull in), just the same underlying numbers this site already syncs from FPL.
  const playerDetails = new Map(
    JSON.parse(document.getElementById('playerDetailSeed').textContent).map((p) => [String(p.id), p])
  );
  const PLAYER_MODAL_STAT_LABELS = [
    ['minutes', 'Minutes'], ['goalsScored', 'Goals'], ['assists', 'Assists'],
    ['cleanSheets', 'Clean sheets'], ['goalsConceded', 'Conceded'], ['saves', 'Saves'],
    ['bonus', 'Bonus'], ['bps', 'BPS'], ['yellowCards', 'Yellow cards'], ['redCards', 'Red cards'],
    ['influence', 'Influence'], ['creativity', 'Creativity'], ['threat', 'Threat'],
    ['lastSeasonPts', "Last season's pts"],
  ];
  function playerModalPhotoUrl(code) {
    return code
      ? `https://resources.premierleague.com/premierleague/photos/players/110x140/p${code}.png`
      : 'https://resources.premierleague.com/premierleague/photos/players/110x140/Photo-Missing.png';
  }
  const modalBackdrop = document.getElementById('playerModalBackdrop');
  function openPlayerModal(id) {
    const p = playerDetails.get(String(id));
    if (!p || !modalBackdrop) return;
    const photoEl = document.getElementById('playerModalPhoto');
    photoEl.src = playerModalPhotoUrl(p.code);
    photoEl.onerror = () => { photoEl.onerror = null; photoEl.src = 'https://resources.premierleague.com/premierleague/photos/players/110x140/Photo-Missing.png'; };
    document.getElementById('playerModalName').textContent = p.name;
    document.getElementById('playerModalSub').textContent = `${p.pos} · ${p.club} · £${(p.nowCost ?? 0).toFixed(1)}m`;
    const newsEl = document.getElementById('playerModalNews');
    if (p.news) { newsEl.textContent = p.news; newsEl.style.display = ''; } else { newsEl.style.display = 'none'; }
    document.getElementById('playerModalHeadline').innerHTML = [
      ['pts', 'Total pts'], ['eventPoints', 'GW pts'], ['expectedPoints', 'Next GW (proj)'], ['selectedByPercent', 'Selected by'],
    ].map(([key, label]) => {
      const val = key === 'selectedByPercent' ? `${(p[key] ?? 0).toFixed(1)}%` : (p[key] ?? '—');
      return `<div class="stat"><div class="num">${val}</div><div class="lbl">${label}</div></div>`;
    }).join('');
    document.getElementById('playerModalStats').innerHTML = PLAYER_MODAL_STAT_LABELS.map(([key, label]) => {
      const raw = p[key];
      const val = raw == null ? '—' : (['influence', 'creativity', 'threat'].includes(key) ? Number(raw).toFixed(1) : raw);
      return `<div class="row"><span>${label}</span><span>${val}</span></div>`;
    }).join('');
    modalBackdrop.classList.add('open');
  }
  function closePlayerModal() {
    modalBackdrop?.classList.remove('open');
  }
  document.addEventListener('click', (e) => {
    const cell = e.target.closest('[data-player-id]');
    if (cell && cell.dataset.playerId) { openPlayerModal(cell.dataset.playerId); return; }
    if (e.target === modalBackdrop) closePlayerModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePlayerModal();
    if (e.key === 'Enter' && document.activeElement?.dataset?.playerId) openPlayerModal(document.activeElement.dataset.playerId);
  });
  document.getElementById('playerModalClose')?.addEventListener('click', closePlayerModal);
</script>
</body>
</html>

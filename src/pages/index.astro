---
import auctionLeagueData from "../data/auctionLeague.json";
import { computeStandings, teamName } from "../lib/auctionLeagueUtils.mjs";

const state = auctionLeagueData as any;
const { teams, fixtures, results, players, meta, liveScores } = state;

const standings = computeStandings(teams, results);

const tickerItems = teams.map(
  (t: any) => `${t.name.toUpperCase()} &middot; ${t.remainingBudget}M LEFT`,
);
const tickerText = tickerItems.join(" &nbsp; / &nbsp; ");

const unpickedCount = players.filter((p: any) => p.draftedBy === null).length;

const FAQ = [
  { cat: "The Basics", items: [
    ["How does the draft work?", "Everyone bids live on players, one at a time, until all 6 squads are full. It's a real auction — whoever bids highest gets the player, no snake-draft turns."],
    ["What's the budget?", "Everyone starts with 100m to build an 11-player squad. Spend it however you like — there's no rule on how much to spend per position."],
    ["Do I need a specific formation?", "No. The only rule is 1 goalkeeper. The other 10 spots can be any mix of defenders, midfielders and forwards you want."],
    ["Can two teams own the same player?", "No. Once a player is bought, they're off the market for everyone else all season."],
    ["Is there a bench?", "No bench. All 11 players you own are your starting XI every Gameweek. If one of them doesn't play, you just take the zero."],
  ]},
  { cat: "Scoring & The Table", items: [
    ["How are points calculated?", "Standard FPL points — whatever each player scores in real Fantasy Premier League that Gameweek is what counts for your team."],
    ["Do captains or chips apply?", "No captaincy and no chips (no Wildcard, Bench Boost, Triple Captain, Free Hit). Just your 11 players' raw points added up."],
    ["How do fixtures work?", "One match per Gameweek slot, just like real Premier League weekends — 3 games happen simultaneously each GW, and every team plays every other team once every 5 Gameweeks, repeating all season."],
    ["How do I win a match?", "Whoever's 11 players score more total points that Gameweek wins. 3 points for a win, 1 each for a draw, 0 for a loss."],
    ["How are ties on the table broken?", "First by total points scored across the season, then by points differential (points for minus points against)."],
  ]},
  { cat: "Transfers & Waivers", items: [
    ["Can I change my squad during the season?", "Yes. You can release a player any time (no fee) and replace them through a mini-bidding process."],
    ["How does replacing a player work?", "You announce who you're releasing. That opens a 24-hour window where anyone — including you — can bid to bring in the replacement."],
    ["What do I bid with?", "A separate waiver budget: 20m per team, plus whatever you didn't spend from your original 100m draft budget."],
    ["When can transfers happen?", "Any time, except during a locked window — from 6 hours before the first game of a Gameweek until that Gameweek finishes."],
    ["Can a transfer be blocked?", "Yes. If 2 or more of the 6 managers vote that a transfer is unfair, it's overturned."],
  ]},
  { cat: "Admin", items: [
    ["Who runs the league?", "Claude keeps the live leaderboard on this site and syncs real FPL scores automatically every 2 hours during Gameweeks, so anything can be corrected quickly if there's a mistake."],
    ["Where do I check live scores?", "The Live Scores tab — it reflects the current Gameweek's matches based on real FPL data as it comes in."],
  ]},
];
---

<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Auction League</title>
<meta name="description" content="A 6-manager FPL auction draft mini-league — rosters, fixtures, standings and live scores." />
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@400;500;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --pitch: #0A1712;
    --pitch-2: #0F1F18;
    --card: #12271D;
    --card-2: #163024;
    --line: #24402F;
    --turf: #37C871;
    --turf-dim: #1F6B3E;
    --amber: #FFB627;
    --white: #F3F6F1;
    --grey: #8AA095;
    --red: #E8543F;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background: radial-gradient(ellipse at top, #12281D 0%, var(--pitch) 55%);
    color: var(--white);
    font-family: 'Work Sans', sans-serif;
    min-height: 100vh;
    padding-bottom: 60px;
  }
  .mono{ font-family:'JetBrains Mono', monospace; }
  .display{ font-family:'Anton', sans-serif; text-transform:uppercase; letter-spacing:0.02em; }

  .ticker-wrap{
    background: var(--turf);
    color: var(--pitch);
    overflow:hidden;
    white-space:nowrap;
    border-bottom: 2px solid var(--pitch);
  }
  .ticker{
    display:inline-block;
    padding: 6px 0;
    animation: scroll-left 28s linear infinite;
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  @keyframes scroll-left{
    0%{ transform: translateX(0%); }
    100%{ transform: translateX(-50%); }
  }

  header.top{
    padding: 28px 24px 0;
    max-width: 1100px;
    margin: 0 auto;
  }
  .brand{
    display:flex;
    align-items:baseline;
    gap: 12px;
    flex-wrap:wrap;
  }
  .brand h1{
    font-size: clamp(32px, 6vw, 56px);
    color: var(--white);
    line-height: 0.95;
  }
  .brand h1 em{ font-style:normal; color: var(--turf); }
  .brand .sub{ color: var(--grey); font-size: 13px; letter-spacing:0.05em; text-transform:uppercase; font-family:'JetBrains Mono', monospace; }

  nav.tabs{
    max-width: 1100px;
    margin: 22px auto 0;
    padding: 0 24px;
    display:flex;
    gap: 4px;
    flex-wrap: wrap;
    border-bottom: 2px solid var(--line);
  }
  nav.tabs button{
    background: transparent;
    border: none;
    color: var(--grey);
    font-family:'Anton', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 14px;
    padding: 12px 16px;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  nav.tabs button:hover{ color: var(--white); }
  nav.tabs button.active{ color: var(--turf); border-bottom-color: var(--turf); }

  main{
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px 0;
  }
  .page{ display:none; animation: fade-in 0.25s ease; }
  .page.active{ display:block; }
  @keyframes fade-in{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);} }

  .section-eyebrow{
    color: var(--turf);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .section-title{
    font-size: clamp(22px, 4vw, 32px);
    margin-bottom: 20px;
  }

  .team-grid{
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .team-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 20px;
    position: relative;
    overflow: hidden;
  }
  .team-card::before{
    content: attr(data-num);
    position:absolute;
    right: 12px; top: -6px;
    font-family:'Anton', sans-serif;
    font-size: 64px;
    color: var(--line);
    opacity:0.5;
    line-height:1;
  }
  .team-card h3{
    font-family:'Anton', sans-serif;
    text-transform:uppercase;
    font-size: 22px;
    letter-spacing:0.02em;
    color: var(--white);
    position:relative;
  }
  .team-card .tag{
    color:var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    margin-bottom: 14px;
    display:block;
  }
  .budget-row{
    display:flex;
    gap: 10px;
    margin-bottom: 14px;
  }
  .budget-pill{
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 8px 12px;
    flex:1;
  }
  .budget-pill .num{
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    font-size: 18px;
    color: var(--turf);
  }
  .budget-pill .lbl{
    font-size: 10px;
    color: var(--grey);
    text-transform:uppercase;
    letter-spacing:0.08em;
  }
  .roster-list{
    list-style:none;
    border-top: 1px dashed var(--line);
    padding-top: 10px;
  }
  .roster-list li{
    display:flex;
    justify-content:space-between;
    padding: 5px 0;
    font-size: 13px;
    color: var(--white);
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .roster-list li .pos{
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size:11px;
    margin-right: 8px;
  }
  .empty-note{
    color: var(--grey);
    font-size: 13px;
    font-style: italic;
    padding: 10px 0;
  }

  .gw-block{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 10px;
  }
  .gw-block summary{
    cursor:pointer;
    font-family:'Anton', sans-serif;
    text-transform:uppercase;
    font-size: 16px;
    color: var(--turf);
    letter-spacing:0.03em;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .gw-block summary::-webkit-details-marker{ display:none; }
  .gw-block summary .chevron{ color: var(--grey); font-family:'JetBrains Mono',monospace; }
  .match-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 10px 4px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .match-row .side{ flex:1; }
  .match-row .side.right{ text-align:right; }
  .match-row .vs{
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 0 14px;
  }

  table.standings{
    width:100%;
    border-collapse: collapse;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow:hidden;
  }
  table.standings th{
    background: var(--card-2);
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing: 0.08em;
    padding: 12px 10px;
    text-align:left;
  }
  table.standings td{
    padding: 12px 10px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  table.standings tbody tr:nth-child(1) td:first-child{ color: var(--turf); font-weight:700; }
  .pts-col{ color: var(--amber); font-family:'JetBrains Mono', monospace; font-weight:700; }

  .live-banner{
    display:flex;
    align-items:center;
    gap:10px;
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 18px;
    font-family:'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--grey);
  }
  .live-dot{
    width:8px; height:8px; border-radius:50%;
    background: var(--red);
    animation: pulse 1.4s infinite;
    flex-shrink:0;
  }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:0.3;} }
  .score-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 14px;
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .score-card .team-name{
    font-family:'Anton', sans-serif;
    text-transform:uppercase;
    font-size: 18px;
    flex:1;
  }
  .score-card .team-name.right{ text-align:right; }
  .score-card .score{
    font-family:'JetBrains Mono', monospace;
    font-size: 32px;
    font-weight:700;
    color: var(--turf);
    padding: 0 24px;
    min-width: 110px;
    text-align:center;
  }

  .search-row{ margin-bottom: 16px; }
  .search-row input{
    width:100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 14px;
    color: var(--white);
    font-family:'Work Sans', sans-serif;
    font-size: 14px;
  }
  table.players{
    width:100%;
    border-collapse: collapse;
  }
  table.players th{
    text-align:left;
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing:0.08em;
    padding: 8px 10px;
    border-bottom: 2px solid var(--line);
  }
  table.players td{
    padding: 9px 10px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  table.players tr:hover td{ background: var(--card-2); }
  .pos-badge{
    font-family:'JetBrains Mono', monospace;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--card-2);
    color: var(--turf);
    border: 1px solid var(--line);
  }
  .drafted-badge{
    font-family:'JetBrains Mono', monospace;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255,182,39,0.12);
    color: var(--amber);
    border: 1px solid var(--line);
  }

  .faq-item{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    margin-bottom: 10px;
    overflow:hidden;
  }
  .faq-item summary{
    cursor:pointer;
    padding: 16px 18px;
    font-weight:600;
    font-size: 15px;
    color: var(--white);
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .faq-item summary::-webkit-details-marker{ display:none; }
  .faq-item summary .plus{
    font-family:'JetBrains Mono', monospace;
    color: var(--turf);
    font-size: 18px;
  }
  .faq-item p{
    padding: 0 18px 18px;
    color: var(--grey);
    font-size: 14px;
    line-height: 1.6;
  }
  .faq-cat{
    color: var(--amber);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing: 0.12em;
    margin: 26px 0 10px;
  }
  .faq-cat:first-child{ margin-top: 0; }

  footer{
    max-width:1100px;
    margin: 40px auto 0;
    padding: 20px 24px;
    color: var(--grey);
    font-size: 12px;
    font-family:'JetBrains Mono', monospace;
    border-top: 1px solid var(--line);
  }

  @media (max-width:600px){
    nav.tabs{ overflow-x:auto; flex-wrap:nowrap; }
    .score-card{ flex-direction:column; gap:10px; }
    .score-card .score{ padding:0; }
  }
</style>
</head>
<body>

<div class="ticker-wrap">
  <div class="ticker" set:html={tickerText + " &nbsp; / &nbsp; " + tickerText}></div>
</div>

<header class="top">
  <div class="brand">
    <h1>THE <em>AUCTION</em> LEAGUE</h1>
  </div>
  <div class="sub">6 managers &middot; 100M budget &middot; 38 gameweeks &middot; no mercy</div>
</header>

<nav class="tabs" id="tabs">
  <button data-page="home" class="active">Home</button>
  <button data-page="fixtures">Fixtures</button>
  <button data-page="standings">Standings</button>
  <button data-page="live">Live Scores</button>
  <button data-page="players">Unpicked Players</button>
  <button data-page="faq">FAQ</button>
</nav>

<main>

  <!-- HOME -->
  <section class="page active" id="page-home">
    <div class="section-eyebrow">Squads</div>
    <div class="section-title">Team Rosters &amp; Budgets</div>
    <div class="team-grid">
      {teams.map((t: any, i: number) => (
        <div class="team-card" data-num={String(i + 1).padStart(2, "0")}>
          <span class="tag">Team {i + 1}</span>
          <h3>{t.name}</h3>
          <div class="budget-row">
            <div class="budget-pill"><div class="num">{t.remainingBudget}M</div><div class="lbl">Squad Budget Left</div></div>
            <div class="budget-pill"><div class="num">{t.waiverBudget}M</div><div class="lbl">Waiver Budget</div></div>
          </div>
          <ul class="roster-list">
            {t.roster.length ? t.roster.map((p: any) => (
              <li><span><span class="pos">{p.pos}</span>{p.name}</span><span>{p.price}M</span></li>
            )) : <li class="empty-note">Squad not drafted yet.</li>}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FIXTURES -->
  <section class="page" id="page-fixtures">
    <div class="section-eyebrow">Season Schedule</div>
    <div class="section-title">All 38 Gameweeks</div>
    <div>
      {fixtures.map((gwObj: any) => (
        <details class="gw-block">
          <summary>Gameweek {gwObj.gw} <span class="chevron">+</span></summary>
          {gwObj.matches.map((m: [number, number]) => (
            <div class="match-row">
              <div class="side">{teamName(teams, m[0])}</div>
              <div class="vs">VS</div>
              <div class="side right">{teamName(teams, m[1])}</div>
            </div>
          ))}
        </details>
      ))}
    </div>
  </section>

  <!-- STANDINGS -->
  <section class="page" id="page-standings">
    <div class="section-eyebrow">League Table</div>
    <div class="section-title">Standings</div>
    <table class="standings">
      <thead>
        <tr><th>#</th><th>Team</th><th>P</th><th>W</th><th>D</th><th>L</th><th>PF</th><th>PA</th><th>Diff</th><th>Pts</th></tr>
      </thead>
      <tbody>
        {standings.map((r: any, i: number) => (
          <tr>
            <td>{i + 1}</td>
            <td>{r.name}</td>
            <td>{r.P}</td><td>{r.W}</td><td>{r.D}</td><td>{r.L}</td>
            <td>{r.PF}</td><td>{r.PA}</td><td>{r.PF - r.PA}</td>
            <td class="pts-col">{r.Pts}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- LIVE -->
  <section class="page" id="page-live">
    <div class="section-eyebrow">This Gameweek</div>
    <div class="section-title">Live Scores</div>
    {liveScores ? (
      <>
        <div class="live-banner"><span class="live-dot"></span> Gameweek {liveScores.gw} is live &mdash; scores refresh automatically roughly every 2 hours.</div>
        <div>
          {liveScores.matches.map((m: any) => (
            <div class="score-card">
              <div class="team-name">{teamName(teams, m.a)}</div>
              <div class="score">{m.scoreA} &ndash; {m.scoreB}</div>
              <div class="team-name right">{teamName(teams, m.b)}</div>
            </div>
          ))}
        </div>
      </>
    ) : (
      <>
        <div class="live-banner"><span class="live-dot"></span> {meta.seasonStatus === "pre-draft" ? "No live data connected yet — scores here are placeholders until the draft happens and a Gameweek kicks off." : "No Gameweek is live right now. Check Fixtures and Standings for the latest."}</div>
        <div>
          {fixtures[0].matches.map((m: [number, number]) => (
            <div class="score-card">
              <div class="team-name">{teamName(teams, m[0])}</div>
              <div class="score">0 &ndash; 0</div>
              <div class="team-name right">{teamName(teams, m[1])}</div>
            </div>
          ))}
        </div>
        <p class="empty-note">Showing Gameweek 1 fixtures.</p>
      </>
    )}
  </section>

  <!-- PLAYERS -->
  <section class="page" id="page-players">
    <div class="section-eyebrow">Free Agents</div>
    <div class="section-title">Unpicked Players ({unpickedCount})</div>
    <div class="search-row"><input type="text" id="playerSearch" placeholder="Search a player, club or position..."></div>
    <table class="players">
      <thead>
        <tr><th>Player</th><th>Pos</th><th>Club</th><th>FPL Pts</th><th></th></tr>
      </thead>
      <tbody id="playersBody">
        {[...players]
          .sort((a: any, b: any) => b.pts - a.pts || a.name.localeCompare(b.name))
          .map((p: any) => (
            <tr data-search={`${p.name} ${p.club} ${p.pos}`.toLowerCase()} data-drafted={p.draftedBy !== null ? "1" : "0"}>
              <td>{p.name}</td>
              <td><span class="pos-badge">{p.pos}</span></td>
              <td>{p.club}</td>
              <td class="mono">{p.pts}</td>
              <td>{p.draftedBy !== null ? <span class="drafted-badge">{teamName(teams, p.draftedBy)}</span> : ""}</td>
            </tr>
          ))}
      </tbody>
    </table>
    <p class="empty-note" id="noPlayersNote" style="display:none;">No players match that search.</p>
  </section>

  <!-- FAQ -->
  <section class="page" id="page-faq">
    <div class="section-eyebrow">Read This First</div>
    <div class="section-title">FAQ &mdash; How This League Works</div>
    <div>
      {FAQ.map((cat) => (
        <>
          <div class="faq-cat">{cat.cat}</div>
          {cat.items.map(([q, a]) => (
            <details class="faq-item">
              <summary>{q}<span class="plus">+</span></summary>
              <p>{a}</p>
            </details>
          ))}
        </>
      ))}
    </div>
  </section>

</main>

<footer>
  THE AUCTION LEAGUE &mdash; run by 6 managers, kept honest by a spreadsheet.
  {meta.lastFplSync && <> Last FPL sync: {new Date(meta.lastFplSync).toUTCString()}.</>}
</footer>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('nav.tabs button');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.page').forEach((p) => p.classList.remove('active'));
      document.getElementById('page-' + btn.dataset.page)?.classList.add('active');
    });
  });

  const searchInput = document.getElementById('playerSearch') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#playersBody tr'));
  const noPlayersNote = document.getElementById('noPlayersNote');
  searchInput?.addEventListener('input', () => {
    const f = searchInput.value.trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const match = !f || (row.dataset.search || '').includes(f);
      row.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (noPlayersNote) noPlayersNote.style.display = visible ? 'none' : '';
  });
</script>
</body>
</html>

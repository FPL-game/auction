---
import auctionLeagueData from "../data/auctionLeague.json";

const state = auctionLeagueData as any;
const { teams, players } = state;
const currentGameweek = state.meta?.currentGameweek ?? 1;

// Slim player list for the searchable dropdown — id/name/pos/club/pts only.
const playerOptions = players.map((p: any) => ({
  id: p.id,
  name: p.name,
  pos: p.pos,
  club: p.club,
}));
---

<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Draft Admin — The Auction League</title>
<meta name="robots" content="noindex, nofollow" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@400;500;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --pitch: #0A1712;
    --card: #12271D;
    --card-2: #163024;
    --line: #24402F;
    --turf: #37C871;
    --amber: #FFB627;
    --white: #F3F6F1;
    --grey: #8AA095;
    --red: #E8543F;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background: radial-gradient(ellipse at top, #12281D 0%, var(--pitch) 55%);
    color: var(--white);
    font-family: 'Work Sans', sans-serif;
    min-height: 100vh;
    padding: 28px 20px 60px;
  }
  .mono{ font-family:'JetBrains Mono', monospace; }
  h1{
    font-family:'Anton', sans-serif;
    text-transform:uppercase;
    letter-spacing:0.02em;
    font-size: clamp(24px, 5vw, 36px);
    margin-bottom: 4px;
  }
  h1 em{ font-style:normal; color: var(--turf); }
  .sub{ color: var(--grey); font-size: 13px; font-family:'JetBrains Mono', monospace; margin-bottom: 24px; }
  .wrap{ max-width: 720px; margin: 0 auto; }
  .card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 16px;
  }
  .card h2{
    font-family:'Anton', sans-serif;
    text-transform:uppercase;
    font-size: 16px;
    color: var(--turf);
    letter-spacing: 0.03em;
    margin-bottom: 14px;
  }
  label{
    display:block;
    font-size: 11px;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color: var(--grey);
    font-family:'JetBrains Mono', monospace;
    margin-bottom: 6px;
  }
  input, select{
    width:100%;
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 12px;
    color: var(--white);
    font-family:'Work Sans', sans-serif;
    font-size: 14px;
    margin-bottom: 14px;
  }
  button{
    background: var(--turf);
    color: var(--pitch);
    border: none;
    border-radius: 8px;
    padding: 12px 18px;
    font-family:'Anton', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 14px;
    cursor: pointer;
  }
  button.secondary{
    background: transparent;
    color: var(--grey);
    border: 1px solid var(--line);
  }
  button.danger{
    background: transparent;
    color: var(--red);
    border: 1px solid var(--red);
  }
  button:disabled{ opacity: 0.5; cursor: not-allowed; }
  .row{ display:flex; gap: 10px; flex-wrap: wrap; }
  .row > *{ flex: 1; min-width: 140px; }
  .msg{ font-size: 13px; margin-top: 4px; margin-bottom: 10px; }
  .msg.error{ color: var(--red); }
  .msg.ok{ color: var(--turf); }
  .budget-list{ list-style:none; }
  .budget-list li{
    display:flex; justify-content:space-between;
    padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.06);
    font-size: 14px;
  }
  .budget-list .amt{ font-family:'JetBrains Mono', monospace; color: var(--turf); }
  .pick-list{ list-style:none; }
  .pick-list li{
    display:flex; justify-content:space-between; align-items:center;
    padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.06);
    font-size: 13px;
  }
  .pick-list .meta{ color: var(--grey); font-family:'JetBrains Mono', monospace; font-size: 11px; }
  .check-list{ margin-bottom: 14px; max-height: 220px; overflow-y: auto; }
  .check-list label.check-row{
    display:flex; align-items:center; gap:8px;
    padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.06);
    font-size: 13px; text-transform:none; letter-spacing:normal;
    color: var(--white); font-family:'Work Sans', sans-serif; margin-bottom: 0;
  }
  .check-list input[type="checkbox"]{ width:auto; margin:0; }
  #app{ display:none; }
</style>
</head>
<body>
<div class="wrap">
  <h1>DRAFT <em>ADMIN</em></h1>
  <div class="sub">The Auction League &mdash; live pick entry</div>

  <div class="card" id="loginCard">
    <h2>Sign In</h2>
    <label for="email">Email</label>
    <input type="email" id="email" autocomplete="username" />
    <label for="password">Password</label>
    <input type="password" id="password" autocomplete="current-password" />
    <button id="loginBtn">Sign In</button>
    <div class="msg error" id="loginMsg"></div>
  </div>

  <div id="app">
    <div class="card">
      <h2>Live Budgets</h2>
      <ul class="budget-list" id="budgetList"></ul>
    </div>

    <div class="card">
      <h2>Add Pick</h2>
      <label for="playerInput">Player</label>
      <input type="text" id="playerInput" list="playerOptions" placeholder="Start typing a name..." autocomplete="off" />
      <datalist id="playerOptions"></datalist>
      <div class="row">
        <div>
          <label for="teamSelect">Team</label>
          <select id="teamSelect"></select>
        </div>
        <div>
          <label for="priceInput">Price (M)</label>
          <input type="number" id="priceInput" min="0" step="0.5" />
        </div>
      </div>
      <button id="addPickBtn">Add Pick</button>
      <div class="msg" id="pickMsg"></div>
    </div>

    <div class="card">
      <h2>Recent Picks</h2>
      <ul class="pick-list" id="pickList"></ul>
      <button class="secondary" id="undoBtn" style="margin-top:10px;">Undo Last Pick</button>
    </div>

    <div class="card">
      <h2>Remove Player</h2>
      <p class="sub" style="margin-bottom:14px;">Releases a player and refunds whatever amount you set below to the team's budget (defaults to 0). To swap someone in, remove first, then use Add Pick above.</p>
      <label for="removeTeamSelect">Team</label>
      <select id="removeTeamSelect"></select>
      <label for="removePlayerSelect">Player</label>
      <select id="removePlayerSelect"></select>
      <label for="refundInput">Refund (M)</label>
      <input type="number" id="refundInput" min="0" step="0.5" value="0" />
      <button class="danger" id="removePlayerBtn">Remove Player</button>
      <div class="msg" id="removeMsg"></div>
    </div>

    <div class="card">
      <h2>Execute Trade</h2>
      <p class="sub" style="margin-bottom:14px;">Swap players (and optionally budget) between two teams in a single atomic move. Logged as one Trade event and announced live on the homepage.</p>
      <div class="row">
        <div>
          <label for="tradeTeamASelect">Team A</label>
          <select id="tradeTeamASelect"></select>
        </div>
        <div>
          <label for="tradeTeamBSelect">Team B</label>
          <select id="tradeTeamBSelect"></select>
        </div>
      </div>
      <label>Players Team A sends to Team B</label>
      <div class="check-list" id="tradeAPlayers"></div>
      <label>Players Team B sends to Team A</label>
      <div class="check-list" id="tradeBPlayers"></div>
      <div class="row">
        <div>
          <label for="tradeBudgetAtoB">Budget A &rarr; B (M)</label>
          <input type="number" id="tradeBudgetAtoB" min="0" step="0.5" value="0" />
        </div>
        <div>
          <label for="tradeBudgetBtoA">Budget B &rarr; A (M)</label>
          <input type="number" id="tradeBudgetBtoA" min="0" step="0.5" value="0" />
        </div>
      </div>
      <button id="executeTradeBtn">Execute Trade</button>
      <div class="msg" id="tradeMsg"></div>
    </div>

    <div class="card">
      <h2>Edit Budget</h2>
      <p class="sub" style="margin-bottom:14px;">Directly sets a team's budget — for corrections, not for normal picks (those adjust budget automatically).</p>
      <label for="budgetTeamSelect">Team</label>
      <select id="budgetTeamSelect"></select>
      <div class="row">
        <div>
          <label for="squadBudgetInput">Squad Budget (M)</label>
          <input type="number" id="squadBudgetInput" step="0.5" />
        </div>
        <div>
          <label for="waiverBudgetInput">Waiver Budget (M)</label>
          <input type="number" id="waiverBudgetInput" step="0.5" />
        </div>
      </div>
      <button id="saveBudgetBtn">Save Budget</button>
      <div class="msg" id="budgetMsg"></div>
    </div>

    <div class="card">
      <h2>Force-Finalize Gameweek</h2>
      <p class="sub" style="margin-bottom:14px;">FPL's own "finished" flag can lag the real final whistle by hours. Force a gameweek final here to make Standings, Match Recap and Social Media update immediately, using live scores as of now. The site also auto-finalizes any gameweek 2 hours after its last kickoff on its own — use this to skip that wait.</p>
      <label for="forceFinalizeGwInput">Gameweek</label>
      <input type="number" id="forceFinalizeGwInput" min="1" step="1" value={currentGameweek} />
      <div class="row">
        <button id="forceFinalizeBtn">Force-Finalize</button>
        <button class="secondary" id="unforceFinalizeBtn">Un-Force</button>
      </div>
      <div class="msg" id="forceFinalizeMsg"></div>
      <p class="sub" id="forceFinalizeStatus" style="margin-top:10px;margin-bottom:0;"></p>
    </div>

    <div class="card">
      <h2>Danger Zone</h2>
      <button class="danger" id="resetBtn">Reset Entire Draft</button>
      <div class="msg" id="resetMsg"></div>
    </div>
  </div>
</div>

<script type="application/json" id="teamsSeed" set:html={JSON.stringify(teams)}></script>
<script type="application/json" id="playersSeed" set:html={JSON.stringify(playerOptions)}></script>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-app.js";
  import {
    getFirestore, doc, getDoc, setDoc, onSnapshot, runTransaction,
    collection, addDoc, query, orderBy, limit, getDocs, deleteDoc, serverTimestamp,
  } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore.js";
  import {
    getAuth, signInWithEmailAndPassword, onAuthStateChanged,
  } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "AIzaSyApmHdW9Jj__ejTY6jKu2j-TG_KyTQYVN4",
    authDomain: "fpl-auction.firebaseapp.com",
    projectId: "fpl-auction",
    storageBucket: "fpl-auction.firebasestorage.app",
    messagingSenderId: "113884648410",
    appId: "1:113884648410:web:ede97721bcf2c57aa3e6e3",
  };
  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);
  const auth = getAuth(app);

  const seedTeams = JSON.parse(document.getElementById('teamsSeed').textContent);
  const seedPlayers = JSON.parse(document.getElementById('playersSeed').textContent);
  const DEFAULTS = { remainingBudget: 100, waiverBudget: 20, roster: [] };
  const liveTeams = {};

  const teamSelect = document.getElementById('teamSelect');
  const removeTeamSelect = document.getElementById('removeTeamSelect');
  const budgetTeamSelect = document.getElementById('budgetTeamSelect');
  const tradeTeamASelect = document.getElementById('tradeTeamASelect');
  const tradeTeamBSelect = document.getElementById('tradeTeamBSelect');
  [teamSelect, removeTeamSelect, budgetTeamSelect, tradeTeamASelect, tradeTeamBSelect].forEach((sel) => {
    seedTeams.forEach((t) => {
      const opt = document.createElement('option');
      opt.value = String(t.id);
      opt.textContent = t.name;
      sel.appendChild(opt);
    });
  });
  if (seedTeams.length > 1) tradeTeamBSelect.selectedIndex = 1;

  function draftedPlayerIds() {
    const set = new Set();
    for (const t of seedTeams) {
      const live = liveTeams[t.id] || DEFAULTS;
      for (const p of live.roster) if (p.playerId != null) set.add(String(p.playerId));
    }
    return set;
  }

  function playerLabel(p) {
    return `${p.name} — ${p.club} (${p.pos})`;
  }

  function refreshPlayerOptions() {
    const drafted = draftedPlayerIds();
    const dl = document.getElementById('playerOptions');
    dl.innerHTML = '';
    seedPlayers
      .filter((p) => !drafted.has(String(p.id)))
      .forEach((p) => {
        const opt = document.createElement('option');
        opt.value = playerLabel(p);
        dl.appendChild(opt);
      });
  }

  function renderBudgets() {
    const list = document.getElementById('budgetList');
    list.innerHTML = seedTeams.map((t) => {
      const live = liveTeams[t.id] || DEFAULTS;
      return `<li><span>${t.name}</span><span class="amt">${live.remainingBudget}M</span></li>`;
    }).join('');
    seedTeams.forEach((t) => {
      const live = liveTeams[t.id] || DEFAULTS;
      const label = `${t.name} (${live.remainingBudget}M left)`;
      const opt1 = teamSelect.querySelector(`option[value="${t.id}"]`);
      if (opt1) opt1.textContent = label;
      const opt2 = removeTeamSelect.querySelector(`option[value="${t.id}"]`);
      if (opt2) opt2.textContent = label;
      const opt3 = budgetTeamSelect.querySelector(`option[value="${t.id}"]`);
      if (opt3) opt3.textContent = label;
    });
  }

  const squadBudgetInput = document.getElementById('squadBudgetInput');
  const waiverBudgetInput = document.getElementById('waiverBudgetInput');
  function renderBudgetInputs() {
    // Don't clobber the field while the admin is actively typing in it.
    if (document.activeElement === squadBudgetInput || document.activeElement === waiverBudgetInput) return;
    const live = liveTeams[budgetTeamSelect.value] || DEFAULTS;
    squadBudgetInput.value = live.remainingBudget;
    waiverBudgetInput.value = live.waiverBudget;
  }
  budgetTeamSelect.addEventListener('change', renderBudgetInputs);

  function renderRemovablePlayers() {
    const removePlayerSelect = document.getElementById('removePlayerSelect');
    const teamId = removeTeamSelect.value;
    const live = liveTeams[teamId] || DEFAULTS;
    const current = removePlayerSelect.value;
    removePlayerSelect.innerHTML = live.roster.length
      ? live.roster.map((p) => `<option value="${p.playerId}">${p.name} — ${p.club} (${p.pos}), ${p.price}m</option>`).join('')
      : '<option value="">No players on this roster</option>';
    if (current && live.roster.some((p) => String(p.playerId) === current)) removePlayerSelect.value = current;
  }
  removeTeamSelect.addEventListener('change', renderRemovablePlayers);

  function renderTradeCheckboxes() {
    const aId = tradeTeamASelect.value;
    const bId = tradeTeamBSelect.value;
    const aLive = liveTeams[aId] || DEFAULTS;
    const bLive = liveTeams[bId] || DEFAULTS;
    const aBox = document.getElementById('tradeAPlayers');
    const bBox = document.getElementById('tradeBPlayers');
    aBox.innerHTML = aLive.roster.length
      ? aLive.roster.map((p) => `<label class="check-row"><input type="checkbox" value="${p.playerId}" /> ${p.name} — ${p.club} (${p.pos}), ${p.price}m</label>`).join('')
      : '<p class="sub" style="margin-bottom:0;">No players on this roster.</p>';
    bBox.innerHTML = bLive.roster.length
      ? bLive.roster.map((p) => `<label class="check-row"><input type="checkbox" value="${p.playerId}" /> ${p.name} — ${p.club} (${p.pos}), ${p.price}m</label>`).join('')
      : '<p class="sub" style="margin-bottom:0;">No players on this roster.</p>';
  }
  tradeTeamASelect.addEventListener('change', renderTradeCheckboxes);
  tradeTeamBSelect.addEventListener('change', renderTradeCheckboxes);

  seedTeams.forEach((t) => {
    onSnapshot(doc(db, 'teams', String(t.id)), (snap) => {
      liveTeams[t.id] = snap.exists() ? snap.data() : { ...DEFAULTS, name: t.name };
      renderBudgets();
      refreshPlayerOptions();
      if (String(t.id) === removeTeamSelect.value) renderRemovablePlayers();
      if (String(t.id) === budgetTeamSelect.value) renderBudgetInputs();
      if (String(t.id) === tradeTeamASelect.value || String(t.id) === tradeTeamBSelect.value) renderTradeCheckboxes();
    });
  });

  function renderPicks() {
    getDocs(query(collection(db, 'draftLog'), orderBy('ts', 'desc'), limit(10))).then((snap) => {
      const list = document.getElementById('pickList');
      if (snap.empty) { list.innerHTML = '<li class="meta">No picks yet.</li>'; return; }
      list.innerHTML = snap.docs.map((d) => {
        const p = d.data();
        if (p.type === 'trade') {
          const aNames = (p.playersAToB || []).map((x) => x.name).join(', ') || 'nothing';
          const bNames = (p.playersBToA || []).map((x) => x.name).join(', ') || 'nothing';
          const budgetBits = [];
          if (p.budgetAToB) budgetBits.push(`${p.budgetAToB}m&rarr;${p.teamBName}`);
          if (p.budgetBToA) budgetBits.push(`${p.budgetBToA}m&rarr;${p.teamAName}`);
          const budgetNote = budgetBits.length ? ` (${budgetBits.join(', ')})` : '';
          return `<li><span>Trade: ${p.teamAName} &harr; ${p.teamBName} <span class="meta">${aNames} for ${bNames}${budgetNote}</span></span></li>`;
        }
        const isRemove = p.type === 'remove';
        const verb = isRemove ? '&larr; released by' : '&rarr;';
        // Removals show the refund actually given, not the player's original price
        // (older entries never had a separate `refund`, so fall back to `price`).
        const amount = isRemove ? (p.refund ?? p.price) : p.price;
        return `<li><span>${p.playerName} <span class="meta">${verb} ${p.teamName}</span></span><span class="meta">${amount}m</span></li>`;
      }).join('');
    });
  }

  // ---- Auth ----
  onAuthStateChanged(auth, (user) => {
    document.getElementById('loginCard').style.display = user ? 'none' : 'block';
    document.getElementById('app').style.display = user ? 'block' : 'none';
    if (user) renderPicks();
  });

  document.getElementById('loginBtn').addEventListener('click', async () => {
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;
    const msg = document.getElementById('loginMsg');
    msg.textContent = '';
    try {
      await signInWithEmailAndPassword(auth, email, password);
    } catch (err) {
      msg.textContent = 'Sign-in failed: ' + err.message;
    }
  });

  // ---- Add pick ----
  document.getElementById('addPickBtn').addEventListener('click', async () => {
    const pickMsg = document.getElementById('pickMsg');
    pickMsg.className = 'msg';
    pickMsg.textContent = '';

    const label = document.getElementById('playerInput').value.trim();
    const teamId = teamSelect.value;
    const price = parseFloat(document.getElementById('priceInput').value);

    const player = seedPlayers.find((p) => playerLabel(p) === label);
    if (!player) { pickMsg.className = 'msg error'; pickMsg.textContent = 'Pick a player from the dropdown list.'; return; }
    if (!teamId) { pickMsg.className = 'msg error'; pickMsg.textContent = 'Select a team.'; return; }
    if (!(price >= 0)) { pickMsg.className = 'msg error'; pickMsg.textContent = 'Enter a valid price.'; return; }
    if (draftedPlayerIds().has(String(player.id))) { pickMsg.className = 'msg error'; pickMsg.textContent = 'That player is already drafted.'; return; }

    const team = seedTeams.find((t) => String(t.id) === teamId);
    const teamRef = doc(db, 'teams', teamId);

    try {
      await runTransaction(db, async (tx) => {
        const snap = await tx.get(teamRef);
        const data = snap.exists() ? snap.data() : { name: team.name, ...DEFAULTS };
        const newBudget = data.remainingBudget - price;
        const newRoster = [...data.roster, { playerId: player.id, name: player.name, pos: player.pos, club: player.club, price }];
        tx.set(teamRef, { ...data, remainingBudget: newBudget, roster: newRoster });
      });
      await addDoc(collection(db, 'draftLog'), {
        type: 'add',
        teamId, teamName: team.name, playerId: player.id, playerName: player.name,
        pos: player.pos, club: player.club, price, ts: serverTimestamp(),
      });
      pickMsg.className = 'msg ok';
      pickMsg.textContent = `Added ${player.name} to ${team.name} for ${price}M.`;
      document.getElementById('playerInput').value = '';
      document.getElementById('priceInput').value = '';
      renderPicks();
    } catch (err) {
      pickMsg.className = 'msg error';
      pickMsg.textContent = 'Failed to save: ' + err.message;
    }
  });

  // ---- Undo last action (add, remove, or trade) ----
  document.getElementById('undoBtn').addEventListener('click', async () => {
    const snap = await getDocs(query(collection(db, 'draftLog'), orderBy('ts', 'desc'), limit(1)));
    if (snap.empty) return;
    const logDoc = snap.docs[0];
    const log = logDoc.data();

    if (log.type === 'trade') {
      if (!confirm(`Reverse the trade between ${log.teamAName} and ${log.teamBName}?`)) return;
      const teamARef = doc(db, 'teams', String(log.teamAId));
      const teamBRef = doc(db, 'teams', String(log.teamBId));
      await runTransaction(db, async (tx) => {
        const aSnap = await tx.get(teamARef);
        const bSnap = await tx.get(teamBRef);
        if (!aSnap.exists() || !bSnap.exists()) return;
        const aData = aSnap.data();
        const bData = bSnap.data();
        const aToBIds = (log.playersAToB || []).map((p) => String(p.playerId));
        const bToAIds = (log.playersBToA || []).map((p) => String(p.playerId));
        // Reverse: strip out whatever crossed over, hand each side back what it originally had.
        const newARoster = [...aData.roster.filter((p) => !bToAIds.includes(String(p.playerId))), ...(log.playersAToB || [])];
        const newBRoster = [...bData.roster.filter((p) => !aToBIds.includes(String(p.playerId))), ...(log.playersBToA || [])];
        const newABudget = aData.remainingBudget + (log.budgetAToB || 0) - (log.budgetBToA || 0);
        const newBBudget = bData.remainingBudget + (log.budgetBToA || 0) - (log.budgetAToB || 0);
        tx.set(teamARef, { ...aData, remainingBudget: newABudget, roster: newARoster });
        tx.set(teamBRef, { ...bData, remainingBudget: newBBudget, roster: newBRoster });
      });
      await deleteDoc(logDoc.ref);
      renderPicks();
      return;
    }

    const isRemove = log.type === 'remove';
    // Old log entries (before per-removal refund amounts existed) never had `refund` —
    // for those, `price` doubled as the refund since removals always refunded in full.
    const removeRefund = log.refund ?? log.price;
    if (!confirm(isRemove
      ? `Re-add ${log.playerName} to ${log.teamName} and claw back the ${removeRefund}m refund?`
      : `Undo ${log.playerName} → ${log.teamName} (${log.price}M)?`)) return;

    const teamRef = doc(db, 'teams', String(log.teamId));
    await runTransaction(db, async (tx) => {
      const teamSnap = await tx.get(teamRef);
      if (!teamSnap.exists()) return;
      const data = teamSnap.data();
      if (isRemove) {
        // Reverse a removal: add the player back at their original price, and
        // claw back whatever refund they were actually given (not the price).
        const newRoster = [...data.roster, { playerId: log.playerId, name: log.playerName, pos: log.pos, club: log.club, price: log.price }];
        tx.set(teamRef, { ...data, remainingBudget: data.remainingBudget - removeRefund, roster: newRoster });
      } else {
        // Reverse an add: remove the player and refund their price.
        const idx = data.roster.findIndex((p) => p.playerId === log.playerId);
        const newRoster = [...data.roster];
        if (idx !== -1) newRoster.splice(idx, 1);
        tx.set(teamRef, { ...data, remainingBudget: data.remainingBudget + log.price, roster: newRoster });
      }
    });
    await deleteDoc(logDoc.ref);
    renderPicks();
  });

  // ---- Remove player ----
  document.getElementById('removePlayerBtn').addEventListener('click', async () => {
    const removeMsg = document.getElementById('removeMsg');
    removeMsg.className = 'msg';
    removeMsg.textContent = '';

    const teamId = removeTeamSelect.value;
    const removePlayerSelect = document.getElementById('removePlayerSelect');
    const playerId = removePlayerSelect.value;
    const team = seedTeams.find((t) => String(t.id) === teamId);
    const refundInput = document.getElementById('refundInput');
    const refund = parseFloat(refundInput.value);

    if (!playerId) { removeMsg.className = 'msg error'; removeMsg.textContent = 'No player selected.'; return; }
    if (!(refund >= 0)) { removeMsg.className = 'msg error'; removeMsg.textContent = 'Enter a valid, non-negative refund amount.'; return; }

    const live = liveTeams[teamId] || DEFAULTS;
    const player = live.roster.find((p) => String(p.playerId) === playerId);
    if (!player) { removeMsg.className = 'msg error'; removeMsg.textContent = 'Player not found on that roster.'; return; }
    if (!confirm(`Remove ${player.name} from ${team.name} and refund ${refund}m?`)) return;

    const teamRef = doc(db, 'teams', teamId);
    try {
      await runTransaction(db, async (tx) => {
        const snap = await tx.get(teamRef);
        const data = snap.exists() ? snap.data() : { name: team.name, ...DEFAULTS };
        const newRoster = data.roster.filter((p) => String(p.playerId) !== playerId);
        tx.set(teamRef, { ...data, remainingBudget: data.remainingBudget + refund, roster: newRoster });
      });
      await addDoc(collection(db, 'draftLog'), {
        type: 'remove',
        teamId, teamName: team.name, playerId: player.playerId, playerName: player.name,
        pos: player.pos, club: player.club, price: player.price, refund, ts: serverTimestamp(),
      });
      removeMsg.className = 'msg ok';
      removeMsg.textContent = `Removed ${player.name} from ${team.name}, refunded ${refund}m.`;
      refundInput.value = '0';
    } catch (err) {
      removeMsg.className = 'msg error';
      removeMsg.textContent = 'Failed: ' + err.message;
    }
  });

  // ---- Execute trade ----
  document.getElementById('executeTradeBtn').addEventListener('click', async () => {
    const tradeMsg = document.getElementById('tradeMsg');
    tradeMsg.className = 'msg';
    tradeMsg.textContent = '';

    const aId = tradeTeamASelect.value;
    const bId = tradeTeamBSelect.value;
    if (!aId || !bId || aId === bId) { tradeMsg.className = 'msg error'; tradeMsg.textContent = 'Pick two different teams.'; return; }

    const teamA = seedTeams.find((t) => String(t.id) === aId);
    const teamB = seedTeams.find((t) => String(t.id) === bId);
    const aLive = liveTeams[aId] || DEFAULTS;
    const bLive = liveTeams[bId] || DEFAULTS;

    const aToBIds = Array.from(document.querySelectorAll('#tradeAPlayers input:checked')).map((el) => el.value);
    const bToAIds = Array.from(document.querySelectorAll('#tradeBPlayers input:checked')).map((el) => el.value);
    const budgetAtoB = parseFloat(document.getElementById('tradeBudgetAtoB').value) || 0;
    const budgetBtoA = parseFloat(document.getElementById('tradeBudgetBtoA').value) || 0;

    if (!aToBIds.length && !bToAIds.length && !budgetAtoB && !budgetBtoA) {
      tradeMsg.className = 'msg error';
      tradeMsg.textContent = 'Select at least one player or a budget amount to trade.';
      return;
    }

    const playersAToB = aLive.roster.filter((p) => aToBIds.includes(String(p.playerId)));
    const playersBToA = bLive.roster.filter((p) => bToAIds.includes(String(p.playerId)));

    const summary = [
      playersAToB.length ? `${teamA.name} sends ${playersAToB.map((p) => p.name).join(', ')} to ${teamB.name}` : null,
      playersBToA.length ? `${teamB.name} sends ${playersBToA.map((p) => p.name).join(', ')} to ${teamA.name}` : null,
      budgetAtoB ? `${teamA.name} sends ${budgetAtoB}m to ${teamB.name}` : null,
      budgetBtoA ? `${teamB.name} sends ${budgetBtoA}m to ${teamA.name}` : null,
    ].filter(Boolean).join('. ');
    if (!confirm(`Confirm trade: ${summary}?`)) return;

    const teamARef = doc(db, 'teams', aId);
    const teamBRef = doc(db, 'teams', bId);

    try {
      await runTransaction(db, async (tx) => {
        const aSnap = await tx.get(teamARef);
        const bSnap = await tx.get(teamBRef);
        const aData = aSnap.exists() ? aSnap.data() : { name: teamA.name, ...DEFAULTS };
        const bData = bSnap.exists() ? bSnap.data() : { name: teamB.name, ...DEFAULTS };

        const newARoster = [...aData.roster.filter((p) => !aToBIds.includes(String(p.playerId))), ...playersBToA];
        const newBRoster = [...bData.roster.filter((p) => !bToAIds.includes(String(p.playerId))), ...playersAToB];
        const newABudget = aData.remainingBudget - budgetAtoB + budgetBtoA;
        const newBBudget = bData.remainingBudget - budgetBtoA + budgetAtoB;

        tx.set(teamARef, { ...aData, remainingBudget: newABudget, roster: newARoster });
        tx.set(teamBRef, { ...bData, remainingBudget: newBBudget, roster: newBRoster });
      });

      await addDoc(collection(db, 'draftLog'), {
        type: 'trade',
        teamAId: aId, teamAName: teamA.name,
        teamBId: bId, teamBName: teamB.name,
        playersAToB: playersAToB.map((p) => ({ playerId: p.playerId, name: p.name, pos: p.pos, club: p.club, price: p.price })),
        playersBToA: playersBToA.map((p) => ({ playerId: p.playerId, name: p.name, pos: p.pos, club: p.club, price: p.price })),
        budgetAToB: budgetAtoB, budgetBToA: budgetBtoA,
        ts: serverTimestamp(),
      });

      tradeMsg.className = 'msg ok';
      tradeMsg.textContent = 'Trade completed.';
      document.getElementById('tradeBudgetAtoB').value = '0';
      document.getElementById('tradeBudgetBtoA').value = '0';
      renderPicks();
    } catch (err) {
      tradeMsg.className = 'msg error';
      tradeMsg.textContent = 'Trade failed: ' + err.message;
    }
  });

  // ---- Edit budget ----
  document.getElementById('saveBudgetBtn').addEventListener('click', async () => {
    const budgetMsg = document.getElementById('budgetMsg');
    budgetMsg.className = 'msg';
    budgetMsg.textContent = '';

    const teamId = budgetTeamSelect.value;
    const team = seedTeams.find((t) => String(t.id) === teamId);
    const squadBudget = parseFloat(squadBudgetInput.value);
    const waiverBudget = parseFloat(waiverBudgetInput.value);

    if (!(squadBudget >= 0) || !(waiverBudget >= 0)) {
      budgetMsg.className = 'msg error';
      budgetMsg.textContent = 'Enter valid, non-negative numbers for both fields.';
      return;
    }
    if (!confirm(`Set ${team.name}'s budget to ${squadBudget}m squad / ${waiverBudget}m waiver?`)) return;

    try {
      await setDoc(doc(db, 'teams', teamId), { remainingBudget: squadBudget, waiverBudget: waiverBudget }, { merge: true });
      budgetMsg.className = 'msg ok';
      budgetMsg.textContent = `${team.name}'s budget updated.`;
    } catch (err) {
      budgetMsg.className = 'msg error';
      budgetMsg.textContent = 'Failed: ' + err.message;
    }
  });

  // ---- Force-Finalize Gameweek override ----
  // Writes the list of manually-forced GWs to a single Firestore doc that
  // scripts/update-fpl-data.mjs reads (public read) on every sync. Needs a
  // Firestore rule allowing public read + authenticated write on this doc,
  // matching the pattern already used for teams/draftLog.
  const forceFinalizeGwInput = document.getElementById('forceFinalizeGwInput');
  const forceFinalizeMsg = document.getElementById('forceFinalizeMsg');
  const forceFinalizeStatus = document.getElementById('forceFinalizeStatus');
  const OVERRIDES_REF = doc(db, 'overrides', 'manualFinalizedGws');

  async function refreshForceFinalizeStatus() {
    const gw = Number(forceFinalizeGwInput.value);
    try {
      const snap = await getDoc(OVERRIDES_REF);
      const gws = snap.exists() ? (snap.data().gws || []) : [];
      forceFinalizeStatus.textContent = gws.includes(gw)
        ? `GW${gw} is currently force-finalized.`
        : `GW${gw} is not force-finalized.`;
    } catch (err) {
      forceFinalizeStatus.textContent = '';
    }
  }
  forceFinalizeGwInput.addEventListener('change', refreshForceFinalizeStatus);
  refreshForceFinalizeStatus();

  async function setForceFinalized(gw, forced) {
    forceFinalizeMsg.textContent = '';
    try {
      const snap = await getDoc(OVERRIDES_REF);
      const gws = new Set(snap.exists() ? (snap.data().gws || []) : []);
      if (forced) gws.add(gw); else gws.delete(gw);
      await setDoc(OVERRIDES_REF, { gws: [...gws] });
      forceFinalizeMsg.className = 'msg ok';
      forceFinalizeMsg.textContent = forced
        ? `GW${gw} force-finalized. Reflects on the site within a few minutes, next data sync.`
        : `GW${gw} un-forced.`;
      refreshForceFinalizeStatus();
    } catch (err) {
      forceFinalizeMsg.className = 'msg error';
      forceFinalizeMsg.textContent = 'Failed: ' + err.message;
    }
  }
  document.getElementById('forceFinalizeBtn').addEventListener('click', () => {
    const gw = Number(forceFinalizeGwInput.value);
    if (!gw || gw < 1) { forceFinalizeMsg.className = 'msg error'; forceFinalizeMsg.textContent = 'Enter a valid gameweek number.'; return; }
    setForceFinalized(gw, true);
  });
  document.getElementById('unforceFinalizeBtn').addEventListener('click', () => {
    const gw = Number(forceFinalizeGwInput.value);
    if (!gw || gw < 1) { forceFinalizeMsg.className = 'msg error'; forceFinalizeMsg.textContent = 'Enter a valid gameweek number.'; return; }
    setForceFinalized(gw, false);
  });

  // ---- Reset draft ----
  document.getElementById('resetBtn').addEventListener('click', async () => {
    if (!confirm('This wipes ALL rosters, budgets and pick history. Are you sure?')) return;
    if (!confirm('Really sure? This cannot be undone.')) return;
    const resetMsg = document.getElementById('resetMsg');
    for (const t of seedTeams) {
      await setDoc(doc(db, 'teams', String(t.id)), { name: t.name, remainingBudget: 100, waiverBudget: 20, roster: [] });
    }
    const logs = await getDocs(collection(db, 'draftLog'));
    await Promise.all(logs.docs.map((d) => deleteDoc(d.ref)));
    resetMsg.className = 'msg ok';
    resetMsg.textContent = 'Draft reset.';
    renderPicks();
  });
</script>
</body>
</html>

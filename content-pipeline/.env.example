# Copy to .env (not committed) and adjust as needed, or export these
# directly in your shell before running anything under acquisition/.

# Where ALL raw and processed football data lives - must be OUTSIDE this git
# repository. The acquisition framework refuses to run if this resolves
# inside the repo (see acquisition/framework.py:resolve_data_root()).
# Layout created under this root: bronze/ silver/ gold/ databases/ manual/
# quarantine/ manifests/
FOOTBALL_DATA_ROOT=/home/user/football-data-lake

# Only needed for acquisition/adapters/football_data_org.py - get a free key
# at https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_API_KEY=
